          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire la copia precedente. Verifica che il disco sia collegato e che tu abbia i permessi di accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧コピーを開けません。ディスクが接続され、アクセス権があることを確認してください。"
