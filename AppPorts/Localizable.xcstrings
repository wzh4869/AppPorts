    "无法打开旧副本，请确认磁盘已连接且有访问权限。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح النسخة القديمة. تأكد من توصيل القرص ومن امتلاكك صلاحية الوصول."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠉⠁⠝’⠞ ⠕⠏⠑⠝ ⠞⠓⠑ ⠕⠇⠙ ⠉⠕⠏⠽⠲ ⠠⠍⠁⠅⠑ ⠎⠥⠗⠑ ⠞⠓⠑ ⠙⠗⠊⠧⠑ ⠊⠎ ⠉⠕⠝⠝⠑⠉⠞⠑⠙ ⠁⠝⠙ ⠞⠓⠁⠞ ⠽⠕⠥ ⠓⠁⠧⠑ ⠁⠉⠉⠑⠎⠎ ⠏⠑⠗⠍⠊⠎⠎⠊⠕⠝⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alte Kopie lässt sich nicht öffnen. Prüfen Sie, ob das Laufwerk verbunden ist und Sie Zugriff darauf haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can’t open the old copy. Make sure the drive is connected and that you have access permission."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne eblas malfermi la malnovan kopion. Kontrolu, ĉu la disko estas konektita kaj ĉu vi havas aliron."
