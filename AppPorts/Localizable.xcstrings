        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первоначальная проверка цели замены не была сохранена. Обе копии сохранены; отмените эту попытку и выберите цель заново."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
