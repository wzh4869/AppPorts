    "扫描入口是符号链接，不能作为真实目录读取。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدخل الفحص رابط رمزي، ولا يمكن قراءته كدليل فعلي."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠎⠉⠁⠝ ⠑⠝⠞⠗⠽ ⠊⠎ ⠁ ⠎⠽⠍⠃⠕⠇⠊⠉ ⠇⠊⠝⠅ ⠁⠝⠙ ⠉⠁⠝⠝⠕⠞ ⠃⠑ ⠗⠑⠁⠙ ⠁⠎ ⠁ ⠗⠑⠁⠇ ⠙⠊⠗⠑⠉⠞⠕⠗⠽⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zu scannende Eintrag ist ein symbolischer Link und kann nicht als echtes Verzeichnis gelesen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scan entry is a symbolic link and cannot be read as a real directory."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eniraĵo de la skanado estas simbola ligilo kaj ne povas esti legata kiel vera dosierujo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada de exploración es un enlace simbólico y no puede leerse como un directorio real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entrée à analyser est un lien symbolique et ne peut pas être lue comme un répertoire réel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन का प्रवेश बिंदु एक प्रतीकात्मक लिंक है और उसे वास्तविक डायरेक्टरी के रूप में नहीं पढ़ा जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titik masuk pemindaian adalah tautan simbolis dan tidak dapat dibaca sebagai direktori nyata."
          }
        },
        "it" : {
