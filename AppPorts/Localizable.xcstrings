        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den App-Pfad. Wenn sich die App auf einem externen Laufwerk befindet, verbinde das Laufwerk und aktualisiere die Ansicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the app path. If the app is on an external disk, connect the disk and refresh."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
