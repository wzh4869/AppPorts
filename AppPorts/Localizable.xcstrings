    "改用另一块 APFS 格式的外部存储，或这块盘上已有的 APFS 分区" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم تخزينًا خارجيًا آخر بتنسيق APFS، أو قسم APFS موجودًا على هذا القرص"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠥⠎⠑ ⠁⠝⠕⠞⠓⠑⠗ ⠠⠁⠠⠏⠠⠋⠠⠎⠤⠋⠕⠗⠍⠁⠞⠞⠑⠙ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠙⠗⠊⠧⠑⠂ ⠕⠗ ⠁⠝ ⠠⠁⠠⠏⠠⠋⠠⠎ ⠏⠁⠗⠞⠊⠞⠊⠕⠝ ⠁⠇⠗⠑⠁⠙⠽ ⠕⠝ ⠞⠓⠊⠎ ⠙⠗⠊⠧⠑"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende einen anderen externen Speicher im APFS-Format oder eine vorhandene APFS-Partition auf diesem Laufwerk"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use another APFS-formatted external drive, or an APFS partition already on this drive"
