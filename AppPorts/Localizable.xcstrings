    "切换迁移方式前，需要先完整还原。其他微信数据不受此操作影响。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم إجراء استعادة كاملة قبل تغيير طريقة الترحيل. لا تتأثر بيانات WeChat الأخرى بهذه العملية."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠋⠥⠇⠇⠽ ⠗⠑⠎⠞⠕⠗⠑ ⠃⠑⠋⠕⠗⠑ ⠎⠺⠊⠞⠉⠓⠊⠝⠛ ⠍⠕⠙⠑⠎⠲ ⠠⠕⠞⠓⠑⠗ ⠠⠺⠑⠠⠉⠓⠁⠞ ⠙⠁⠞⠁ ⠊⠎ ⠥⠝⠁⠋⠋⠑⠉⠞⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Wechsel des Migrationsmodus ist eine vollständige Wiederherstellung nötig. Andere WeChat-Daten sind davon nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fully restore before switching modes. Other WeChat data is unaffected."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaŭ ol ŝanĝi la migradan reĝimon necesas plena restarigo. Aliaj WeChat-datumoj ne estas tuŝitaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de cambiar el modo de migración hay que restaurar por completo. El resto de los datos de WeChat no se ve afectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une restauration complète est nécessaire avant de changer de mode de migration. Les autres données WeChat ne sont pas affectées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइग्रेशन मोड बदलने से पहले पूरी तरह पुनर्स्थापित करना आवश्यक है। अन्य WeChat डेटा इससे प्रभावित नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
