          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن أن تكون كلمة المرور فارغة، ولا أن تحتوي على فواصل أسطر أو أحرف فارغة، ويجب ألا يتجاوز طولها 1024 بايت."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠏⠁⠎⠎⠺⠕⠗⠙ ⠉⠁⠝’⠞ ⠃⠑ ⠑⠍⠏⠞⠽⠂ ⠉⠁⠝’⠞ ⠉⠕⠝⠞⠁⠊⠝ ⠇⠊⠝⠑ ⠃⠗⠑⠁⠅⠎ ⠕⠗ ⠝⠥⠇⠇ ⠉⠓⠁⠗⠁⠉⠞⠑⠗⠎⠂ ⠁⠝⠙ ⠍⠥⠎⠞ ⠃⠑ ⠼⠁⠚⠃⠙ ⠃⠽⠞⠑⠎ ⠕⠗ ⠎⠓⠕⠗⠞⠑⠗⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort darf nicht leer sein, keine Zeilenumbrüche oder Nullzeichen enthalten und höchstens 1024 Byte lang sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password can’t be empty, can’t contain line breaks or null characters, and must be 1024 bytes or shorter."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pasvorto ne rajtas esti malplena, enhavi linifinojn aŭ nulajn signojn, kaj ĝia longo ne rajtas superi 1024 bajtojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña no puede estar vacía ni contener saltos de línea o caracteres nulos, y no puede superar los 1024 bytes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe ne peut pas être vide, ni contenir de saut de ligne ou de caractère nul, et ne doit pas dépasser 1024 octets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड खाली नहीं हो सकता, उसमें लाइन ब्रेक या null वर्ण नहीं हो सकते और उसकी लंबाई 1024 बाइट से अधिक नहीं हो सकती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi tidak boleh kosong, tidak boleh berisi jeda baris atau karakter null, dan panjangnya maksimal 1024 byte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password non può essere vuota, non può contenere interruzioni di riga o caratteri nulli e non deve superare i 1024 byte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードは空にできません。改行や null 文字を含めることもできず、長さは 1024 バイト以下にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 비워 둘 수 없고, 줄바꿈이나 null 문자를 포함할 수 없으며, 길이가 1024바이트를 넘을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachtwoord mag niet leeg zijn, geen regeleinden of null-tekens bevatten en mag maximaal 1024 bytes lang zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło nie może być puste, nie może zawierać znaków nowej linii ani znaków null, a jego długość nie może przekraczać 1024 bajtów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha não pode ficar vazia, não pode conter quebras de linha ou caracteres nulos e deve ter no máximo 1024 bytes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль не может быть пустым, содержать переводы строк или нулевые символы, а его длина не может превышать 1024 байта."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสผ่านต้องไม่ว่างเปล่า ต้องไม่มีอักขระขึ้นบรรทัดใหม่หรืออักขระ null และต้องยาวไม่เกิน 1024 ไบต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola boş olamaz, satır sonu veya null karakter içeremez ve 1024 baytı aşamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu không được để trống, không được chứa dấu xuống dòng hay ký tự null và không dài quá 1024 byte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码不能为空，且不能包含换行或空字符，长度不能超过 1024 字节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼不能為空，且不能包含換行或空字元，長度不能超過 1024 位元組。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码⑧能为空，且⑧能包含換荇或空字符，长度⑧能超過 1024 字节。"
          }
        }
      }
    },
