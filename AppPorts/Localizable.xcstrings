    "只将这条迁移记录强制归档为未完成，解除其占用，不删除任何文件；下次迁移可以重新开始。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤرشف سجل الترحيل هذا فقط قسرًا كغير مكتمل وتحرر حجزه. لا تُحذف أي ملفات، ويمكنك بدء الترحيل من جديد لاحقًا."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠋⠕⠗⠉⠑⠤⠁⠗⠉⠓⠊⠧⠑⠎ ⠕⠝⠇⠽ ⠞⠓⠊⠎ ⠍⠊⠛⠗⠁⠞⠊⠕⠝ ⠗⠑⠉⠕⠗⠙ ⠁⠎ ⠊⠝⠉⠕⠍⠏⠇⠑⠞⠑ ⠁⠝⠙ ⠗⠑⠇⠑⠁⠎⠑⠎ ⠊⠞⠎ ⠉⠇⠁⠊⠍⠲ ⠠⠝⠕ ⠋⠊⠇⠑⠎ ⠁⠗⠑ ⠙⠑⠇⠑⠞⠑⠙⠆ ⠽⠕⠥ ⠉⠁⠝ ⠎⠞⠁⠗⠞ ⠞⠓⠑ ⠍⠊⠛⠗⠁⠞⠊⠕⠝ ⠁⠛⠁⠊⠝ ⠇⠁⠞⠑⠗⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviert nur diesen Migrationsdatensatz zwangsweise als unvollständig und gibt dessen Belegung frei. Es werden keine Dateien gelöscht; Sie können die Migration später neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force-archives only this migration record as incomplete and releases its claim. No files are deleted; you can start the migration again later."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devige arkivas nur ĉi tiun migran registron kiel nekompletigitan kaj liberigas ĝian okupon. Neniu dosiero estas forigita; vi povos rekomenci la migradon poste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiva a la fuerza solo este registro de migración como incompleto y libera su reserva. No se elimina ningún archivo; puedes reiniciar la migración más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive de force uniquement cette entrée de migration comme inachevée et libère sa réservation. Aucun fichier n’est supprimé ; vous pourrez relancer la migration plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल इस माइग्रेशन रिकॉर्ड को ज़बरदस्ती अपूर्ण के रूप में संग्रहित करता है और उसका कब्ज़ा हटाता है। कोई फ़ाइल नहीं मिटती; अगली बार माइग्रेशन फिर से शुरू कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengarsipkan paksa hanya catatan migrasi ini sebagai belum selesai dan melepaskan pengunciannya. Tidak ada file yang dihapus; migrasi dapat dimulai lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia con la forza solo questo record di migrazione come incompleto e ne libera l’occupazione. Nessun file viene eliminato; potrai riavviare la migrazione più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この移行記録だけを強制的に未完了としてアーカイブし、占有を解除します。ファイルは削除されず、次回の移行は最初からやり直せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 마이그레이션 기록만 강제로 미완료로 보관하고 점유를 해제합니다. 파일은 삭제되지 않으며, 다음 마이그레이션을 새로 시작할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiveert alleen deze migratieregistratie geforceerd als onvoltooid en geeft de reservering vrij. Er worden geen bestanden verwijderd; je kunt de migratie later opnieuw starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymusza zarchiwizowanie tylko tego zapisu migracji jako nieukończonego i zwalnia jego zajęcie. Żadne pliki nie są usuwane; migrację można rozpocząć ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquiva à força apenas este registo de migração como incompleto e liberta a sua reserva. Nenhum ficheiro é apagado; pode reiniciar a migração mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительно архивирует только эту запись о переносе как незавершённую и снимает её блокировку. Файлы не удаляются; перенос можно начать заново."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
