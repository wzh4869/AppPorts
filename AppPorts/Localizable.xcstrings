        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il risultato della copia è stato controllato. Prima di cambiare l’accesso ai dati, si conferma che i file che verranno usati sono completi e non modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー結果は確認済みです。入口を切り替える前に、これから使用するファイルが完全で変更されていないことを再確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
