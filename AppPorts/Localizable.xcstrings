        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂载迁移未完成，原数据保留在「%@」，未覆盖当前路径。外置卷「%@」（%@）也已保留。请检查挂载点后再恢复。%@"
