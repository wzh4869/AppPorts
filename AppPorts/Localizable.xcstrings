    "正在迁移或迁回应用数据，请等待完成后再打开。" : {
      "comment" : "Translated in all supported languages. The standalone launcher uses system language preferences.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجري نقل بيانات التطبيق أو إعادتها إلى موقعها الأصلي. انتظر حتى تكتمل العملية قبل فتح التطبيق."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠏⠏⠇⠊⠉⠁⠞⠊⠕⠝ ⠙⠁⠞⠁ ⠊⠎ ⠃⠑⠊⠝⠛ ⠍⠊⠛⠗⠁⠞⠑⠙ ⠕⠗ ⠗⠑⠎⠞⠕⠗⠑⠙⠲ ⠠⠺⠁⠊⠞ ⠋⠕⠗ ⠊⠞ ⠞⠕ ⠋⠊⠝⠊⠎⠓ ⠃⠑⠋⠕⠗⠑ ⠕⠏⠑⠝⠊⠝⠛ ⠞⠓⠑ ⠁⠏⠏⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Daten werden gerade migriert oder an ihren ursprünglichen Speicherort zurückverschoben. Warten Sie auf den Abschluss, bevor Sie die App öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application data is being migrated or restored. Wait for it to finish before opening the app."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La datumoj de la aplikaĵo estas migrataj aŭ retranslokataj al sia origina loko. Atendu la finon antaŭ ol malfermi la aplikaĵon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de la aplicación se están migrando o devolviendo a su ubicación original. Espera a que termine antes de abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de l’application sont en cours de migration ou de retour à leur emplacement d’origine. Attendez la fin avant d’ouvrir l’application."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का डेटा स्थानांतरित किया जा रहा है या उसके मूल स्थान पर वापस ले जाया जा रहा है। ऐप खोलने से पहले प्रक्रिया पूरी होने तक प्रतीक्षा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data aplikasi sedang dipindahkan atau dikembalikan ke lokasi asalnya. Tunggu hingga selesai sebelum membuka aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati dell’applicazione sono in corso di migrazione o di ritorno alla posizione originale. Attendi il completamento prima di aprire l’applicazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのデータを移行または元の場所へ戻しています。完了してからアプリを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 데이터를 이전하거나 원래 위치로 되돌리는 중입니다. 완료될 때까지 기다린 후 앱을 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De appgegevens worden verplaatst of teruggezet naar hun oorspronkelijke locatie. Wacht tot dit klaar is voordat u de app opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane aplikacji są przenoszone lub przywracane do pierwotnego położenia. Przed otwarciem aplikacji zaczekaj na zakończenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados da aplicação estão a ser migrados ou repostos na localização original. Aguarde a conclusão antes de abrir a aplicação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные приложения переносятся или возвращаются на исходное место. Дождитесь завершения, прежде чем открывать приложение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำลังย้ายข้อมูลแอปหรือย้ายกลับไปยังตำแหน่งเดิม โปรดรอให้เสร็จสิ้นก่อนเปิดแอป"
          }
        },
        "tr" : {
