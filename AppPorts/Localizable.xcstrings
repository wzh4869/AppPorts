        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作尚需检查，所有已记录的副本都会保留。请先检查这些位置，不要合并或覆盖数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作仍需檢查，所有已記錄的副本都會保留。請先檢查這些位置，不要合併或覆寫資料。"
