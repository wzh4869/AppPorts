          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリ転送の記録を読み取れません。記録とデータは保持されています。競合しない他の操作は続行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
