    "Could not read the App Store installation setting. Open App Store Settings to check it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة إعداد التثبيت في App Store. افتح إعدادات App Store للتحقق منه."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠉⠕⠥⠇⠙ ⠝⠕⠞ ⠗⠑⠁⠙ ⠞⠓⠑ ⠠⠁⠏⠏ ⠠⠎⠞⠕⠗⠑ ⠊⠝⠎⠞⠁⠇⠇⠁⠞⠊⠕⠝ ⠎⠑⠞⠞⠊⠝⠛⠲ ⠠⠕⠏⠑⠝ ⠠⠁⠏⠏ ⠠⠎⠞⠕⠗⠑ ⠠⠎⠑⠞⠞⠊⠝⠛⠎ ⠞⠕ ⠉⠓⠑⠉⠅ ⠊⠞⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App Store-Installationseinstellung konnte nicht gelesen werden. Öffne die App Store-Einstellungen zur Überprüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not read the App Store installation setting. Open App Store Settings to check it."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne eblis legi la instal-agordon de App Store. Malfermu la agordojn de App Store por kontroli ĝin."
