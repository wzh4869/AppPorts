        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aŭtomata reakiro estas nekompleta. Reakiro-rekordoj estas konservitaj. La sekva provo kontrolos kie troviĝas la datumoj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación automática está incompleta. Se conservan los registros de recuperación. El próximo intento comprobará dónde se encuentran los datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération automatique est incomplète. Les enregistrements de récupération sont conservés. La prochaine tentative vérifiera où se trouvent les données."
