    "扫描入口是符号链接，不能作为真实目录读取。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدخل الفحص رابط رمزي، ولا يمكن قراءته كدليل فعلي."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠎⠉⠁⠝ ⠑⠝⠞⠗⠽ ⠊⠎ ⠁ ⠎⠽⠍⠃⠕⠇⠊⠉ ⠇⠊⠝⠅ ⠁⠝⠙ ⠉⠁⠝⠝⠕⠞ ⠃⠑ ⠗⠑⠁⠙ ⠁⠎ ⠁ ⠗⠑⠁⠇ ⠙⠊⠗⠑⠉⠞⠕⠗⠽⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zu scannende Eintrag ist ein symbolischer Link und kann nicht als echtes Verzeichnis gelesen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scan entry is a symbolic link and cannot be read as a real directory."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eniraĵo de la skanado estas simbola ligilo kaj ne povas esti legata kiel vera dosierujo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada de exploración es un enlace simbólico y no puede leerse como un directorio real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entrée à analyser est un lien symbolique et ne peut pas être lue comme un répertoire réel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन का प्रवेश बिंदु एक प्रतीकात्मक लिंक है और उसे वास्तविक डायरेक्टरी के रूप में नहीं पढ़ा जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titik masuk pemindaian adalah tautan simbolis dan tidak dapat dibaca sebagai direktori nyata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce da esaminare è un collegamento simbolico e non può essere letta come una directory reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャン対象の入口はシンボリックリンクのため、実体のディレクトリとして読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔 진입점은 심볼릭 링크이므로 실제 디렉터리로 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het startpunt van de scan is een symbolische koppeling en kan niet als een echte map worden gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkt wejścia skanowania jest dowiązaniem symbolicznym i nie można go odczytać jako rzeczywistego katalogu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada a ser examinada é um link simbólico e não pode ser lida como um diretório real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Входной объект сканирования является символической ссылкой и не может быть прочитан как реальный каталог."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จุดเริ่มต้นการสแกนเป็นลิงก์สัญลักษณ์ จึงไม่สามารถอ่านเป็นไดเรกทอรีจริงได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama giriş noktası bir sembolik bağlantıdır ve gerçek bir dizin olarak okunamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục đầu vào quét là liên kết tượng trưng, không thể đọc như một thư mục thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描入口是符号链接，不能作为真实目录读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
