          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’operazione sui dati non è terminata e i file esistenti sono stati conservati. Chiudi l’app associata, collega e sblocca il disco esterno, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ操作はまだ完了していません。既存のファイルは保持されています。関連アプリを終了し、外付けドライブを接続してロック解除してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 작업이 아직 끝나지 않았으며 기존 파일은 보존되었습니다. 관련 앱을 종료하고 외장 드라이브를 연결한 뒤 잠금을 해제하고 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gegevensbewerking is nog niet voltooid; de bestaande bestanden zijn bewaard. Sluit de bijbehorende app af, sluit de externe schijf aan, ontgrendel deze en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operacja na danych nie została ukończona, istniejące pliki zostały zachowane. Zamknij powiązaną aplikację, podłącz i odblokuj dysk zewnętrzny, a następnie spróbuj ponownie."
          }
        },
        "pt" : {
