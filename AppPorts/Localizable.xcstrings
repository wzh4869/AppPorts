        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tự động xóa một số bản ghi quyền cũ. Trong Cài đặt hệ thống, hãy chọn mục AppPorts cũ, nhấn “-” để xóa rồi thêm lại AppPorts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能自动清理部分旧版授权记录，请在系统设置中选中旧的 AppPorts 后点“-”移除再重新添加。"
