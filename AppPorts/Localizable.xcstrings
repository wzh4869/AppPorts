    },
    "App Store、iOS 应用和套件目录暂不处理，以保留安装更新路径和文档搜索。" : {
      "comment" : "Search exclusion. English fallback for locales other than English and Simplified/Traditional Chinese; translations pending review.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُعالَج تطبيقات App Store وتطبيقات iOS ومجلدات الحزم في الوقت الحالي، للحفاظ على مسارات التحديث والبحث في المستندات."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠏⠏ ⠠⠎⠞⠕⠗⠑ ⠁⠏⠏⠎⠂ ⠊⠠⠕⠠⠎ ⠁⠏⠏⠎⠂ ⠁⠝⠙ ⠎⠥⠊⠞⠑ ⠋⠕⠇⠙⠑⠗⠎ ⠁⠗⠑ ⠇⠑⠋⠞ ⠊⠝ ⠏⠇⠁⠉⠑ ⠞⠕ ⠏⠗⠑⠎⠑⠗⠧⠑ ⠥⠏⠙⠁⠞⠑⠎ ⠁⠝⠙ ⠙⠕⠉⠥⠍⠑⠝⠞ ⠎⠑⠁⠗⠉⠓⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps aus dem App Store, iOS-Apps und Suite-Ordner werden vorerst nicht verarbeitet, damit die Update-Pfade und die Dokumentsuche erhalten bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store apps, iOS apps, and suite folders are left in place to preserve updates and document search."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaĵoj el App Store, iOS-aplikaĵoj kaj suitdosierujoj ankoraŭ ne estas pritraktataj, por konservi ĝisdatigajn vojojn kaj dokumentoserĉadon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de App Store, las apps de iOS y las carpetas de suites no se procesan por ahora, para conservar las rutas de actualización y la búsqueda de documentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps de l’App Store, les apps iOS et les dossiers de suites ne sont pas traités pour l’instant, afin de préserver les chemins de mise à jour et la recherche de documents."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store और iOS ऐप्स तथा सूट फ़ोल्डर अभी संसाधित नहीं होते, ताकि इंस्टॉल अपडेट पथ और दस्तावेज़ खोज बनी रहे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App dari App Store, app iOS, dan folder suite untuk sementara tidak diproses, agar jalur pembaruan dan pencarian dokumen tetap terjaga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app di App Store, le app iOS e le cartelle suite non vengono elaborate per ora, per conservare i percorsi di aggiornamento e la ricerca dei documenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store と iOS のアプリ、スイートフォルダは当面処理しません。インストール更新の経路と書類検索を保つためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 및 iOS 앱과 스위트 폴더는 당분간 처리하지 않습니다. 설치 업데이트 경로와 문서 검색을 유지하기 위해서입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps uit de App Store, iOS-apps en suite-mappen worden voorlopig niet verwerkt, om updatepaden en het zoeken in documenten te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje z App Store, aplikacje iOS i foldery pakietów nie są na razie przetwarzane, aby zachować ścieżki aktualizacji i wyszukiwanie dokumentów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps do App Store, apps iOS e pastas de suítes não são processadas por enquanto, para preservar os caminhos de atualização e a busca de documentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения из App Store, приложения iOS и папки наборов пока не обрабатываются, чтобы сохранить пути обновления и поиск по документам."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปจาก App Store แอป iOS และโฟลเดอร์ชุดแอปจะยังไม่ถูกประมวลผลในตอนนี้ เพื่อรักษาเส้นทางการอัปเดตและค้นหาเอกสาร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store uygulamaları, iOS uygulamaları ve paket klasörleri şimdilik işlenmez; güncelleme yolları ve belge araması korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng App Store, ứng dụng iOS và thư mục bộ ứng dụng hiện chưa được xử lý, để giữ đường dẫn cập nhật và tìm kiếm tài liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store、iOS 应用和套件目录暂不处理，以保留安装更新路径和文档搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store、iOS App 和套件目錄暫不處理，以保留安裝更新路徑和文件搜尋。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store、iOS 應詠啝套件目錄暫⑧處理，以葆畱安装哽噺路徑啝攵档搜索。"
          }
        }
      }
    },
