        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đích không vượt qua bước xác minh chữ ký hiện có. Bản gốc đã được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标应用未通过原有签名校验，原件已保留。"
          }
