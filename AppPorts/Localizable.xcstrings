    "国内更新包暂不可用，请重试或前往国内下载站手动下载。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حزمة التحديث الصينية غير متاحة. أعد المحاولة أو نزّلها يدوياً من موقع التنزيل الصيني."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠞⠓⠑ ⠉⠓⠊⠝⠁ ⠥⠏⠙⠁⠞⠑ ⠏⠁⠉⠅⠁⠛⠑ ⠊⠎ ⠥⠝⠁⠧⠁⠊⠇⠁⠃⠇⠑. ⠗⠑⠞⠗⠽ ⠕⠗ ⠙⠕⠺⠝⠇⠕⠁⠙ ⠍⠁⠝⠥⠁⠇⠇⠽ ⠋⠗⠕⠍ ⠞⠓⠑ ⠉⠓⠊⠝⠁ ⠙⠕⠺⠝⠇⠕⠁⠙ ⠎⠊⠞⠑."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das chinesische Updatepaket ist nicht verfügbar. Erneut versuchen oder manuell von der chinesischen Downloadseite laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The China update package is unavailable. Retry or download manually from the China download site."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ĉina ĝisdatiga pakaĵo ne disponeblas. Reprovu aŭ elŝutu permane de la ĉina elŝutejo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete de actualización de China no está disponible. Reinténtalo o descárgalo manualmente desde el sitio de China."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet de mise à jour en Chine est indisponible. Réessayez ou téléchargez-le manuellement sur le site chinois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चीनी अपडेट पैकेज उपलब्ध नहीं है। फिर से प्रयास करें या चीनी डाउनलोड साइट से मैन्युअल रूप से डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket pembaruan Tiongkok tidak tersedia. Coba lagi atau unduh secara manual dari situs unduhan Tiongkok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pacchetto di aggiornamento cinese non è disponibile. Riprova o scaricalo manualmente dal sito cinese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国の更新パッケージを利用できません。再試行するか、中国のダウンロードサイトから手動でダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중국 업데이트 패키지를 사용할 수 없습니다. 다시 시도하거나 중국 다운로드 사이트에서 수동으로 다운로드하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
