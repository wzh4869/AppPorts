    "准备尚未完成，可取消并清理本次临时副本" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحضير غير مكتمل. يمكنك إلغاؤه وإزالة هذه النسخة المؤقتة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠏⠗⠑⠏⠁⠗⠁⠞⠊⠕⠝ ⠊⠎ ⠊⠝⠉⠕⠍⠏⠇⠑⠞⠑⠲ ⠠⠽⠕⠥ ⠉⠁⠝ ⠉⠁⠝⠉⠑⠇ ⠁⠝⠙ ⠗⠑⠍⠕⠧⠑ ⠞⠓⠊⠎ ⠞⠑⠍⠏⠕⠗⠁⠗⠽ ⠉⠕⠏⠽⠲"
