    "数据在操作期间发生变化或校验不一致，已保留副本，请检查后重试：%@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيرت البيانات أثناء العملية أو لم تتطابق نتائج التحقق. حُفظت النسخ. افحصها قبل إعادة المحاولة: %@"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠙⠁⠞⠁ ⠉⠓⠁⠝⠛⠑⠙ ⠙⠥⠗⠊⠝⠛ ⠞⠓⠑ ⠕⠏⠑⠗⠁⠞⠊⠕⠝ ⠕⠗ ⠧⠑⠗⠊⠋⠊⠉⠁⠞⠊⠕⠝ ⠙⠊⠙ ⠝⠕⠞ ⠍⠁⠞⠉⠓⠲ ⠠⠉⠕⠏⠊⠑⠎ ⠺⠑⠗⠑ ⠏⠗⠑⠎⠑⠗⠧⠑⠙⠲ ⠠⠊⠝⠎⠏⠑⠉⠞ ⠞⠓⠑⠍ ⠃⠑⠋⠕⠗⠑ ⠗⠑⠞⠗⠽⠊⠝⠛⠒ %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten wurden während des Vorgangs geändert oder die Prüfung ergab Abweichungen. Kopien bleiben erhalten. Prüfe sie vor einem erneuten Versuch: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data changed during the operation or verification did not match. Copies were preserved. Inspect them before retrying: %@"
