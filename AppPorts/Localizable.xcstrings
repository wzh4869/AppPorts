        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de changer l’emplacement des données en toute sécurité. Les données existantes sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटा का स्थान सुरक्षित रूप से बदला नहीं जा सका। मौजूदा डेटा सुरक्षित रखा गया है।"
