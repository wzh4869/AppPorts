        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी वॉल्यूम अनमाउंट हो चुके हैं, लेकिन डिवाइस अभी भी जुड़ा हुआ है। डिवाइस को निकालकर फिर से जोड़ें।"
