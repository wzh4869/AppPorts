      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال العناصر المحفوظة في المواقع المدرجة. يمكنك إدارتها في Finder أو إزالة هذا السجل فقط."
