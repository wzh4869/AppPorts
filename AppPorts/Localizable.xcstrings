          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporäre Elemente der Wiederherstellung sind noch vorhanden. Der Wiederherstellungseintrag wurde nicht entfernt. Bitte prüfe zuerst den temporären Speicherort: "
