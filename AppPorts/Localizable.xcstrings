        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ใช้ยกเลิกการอนุญาตสิทธิ์ผู้ดูแลระบบ จึงเรียกใช้คำสั่งดิสก์ไม่ได้ (%@)"
