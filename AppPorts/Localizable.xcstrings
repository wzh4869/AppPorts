    "改用另一块 APFS 格式的外部存储，或这块盘上已有的 APFS 分区" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم تخزينًا خارجيًا آخر بتنسيق APFS، أو قسم APFS موجودًا على هذا القرص"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠥⠎⠑ ⠁⠝⠕⠞⠓⠑⠗ ⠠⠁⠠⠏⠠⠋⠠⠎⠤⠋⠕⠗⠍⠁⠞⠞⠑⠙ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠙⠗⠊⠧⠑⠂ ⠕⠗ ⠁⠝ ⠠⠁⠠⠏⠠⠋⠠⠎ ⠏⠁⠗⠞⠊⠞⠊⠕⠝ ⠁⠇⠗⠑⠁⠙⠽ ⠕⠝ ⠞⠓⠊⠎ ⠙⠗⠊⠧⠑"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende einen anderen externen Speicher im APFS-Format oder eine vorhandene APFS-Partition auf diesem Laufwerk"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use another APFS-formatted external drive, or an APFS partition already on this drive"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzu alian eksteran konservilon kun formato APFS, aŭ jam ekzistantan subdiskon APFS sur ĉi tiu disko"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa otro almacenamiento externo con formato APFS o una partición APFS que ya exista en este disco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un autre stockage externe au format APFS ou une partition APFS déjà présente sur ce disque"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरा APFS फ़ॉर्मैट वाला बाहरी स्टोरेज चुनें या इस ड्राइव पर मौजूद APFS विभाजन इस्तेमाल करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan penyimpanan eksternal lain berformat APFS, atau partisi APFS yang sudah ada di drive ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un’altra unità esterna in formato APFS oppure una partizione APFS già presente su questa unità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の APFS フォーマットの外部ストレージ、またはこのドライブにある既存の APFS パーティションを使用する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 APFS 포맷의 외장 저장 장치나 이 드라이브에 이미 있는 APFS 파티션을 사용하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een andere externe APFS-schijf of een bestaande APFS-partitie op deze schijf"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj innego nośnika zewnętrznego APFS lub istniejącej partycji APFS na tym dysku"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use outra unidade externa em formato APFS ou uma partição APFS já existente nesta unidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте другой внешний накопитель APFS или уже существующий раздел APFS на этом накопителе"
          }
        },
