        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호를 이 Mac의 키체인에 저장하지 못해 작업을 중단했습니다. 다시 시도하거나 암호 저장을 취소하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachtwoord kon niet in de sleutelhanger van deze Mac worden bewaard, dus de bewerking is gestopt. Probeer het opnieuw of annuleer het bewaren van het wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać hasła w pęku kluczy tego Maca, więc operację zatrzymano. Spróbuj ponownie lub anuluj zapisywanie hasła."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar a senha no chaveiro deste Mac, então a operação foi interrompida. Tente novamente ou cancele o salvamento da senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить пароль в связке ключей этого Mac, поэтому операция остановлена. Повторите попытку или отмените сохранение пароля."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกรหัสผ่านลงพวงกุญแจของ Mac เครื่องนี้ไม่สำเร็จ จึงหยุดการดำเนินการแล้ว กรุณาลองอีกครั้งหรือยกเลิกการบันทึกรหัสผ่าน"
