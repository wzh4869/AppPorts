          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠝⠕⠞⠓⠑⠗ ⠊⠞⠑⠍ ⠁⠏⠏⠑⠁⠗⠑⠙ ⠁⠞ ⠞⠓⠑ ⠙⠑⠎⠞⠊⠝⠁⠞⠊⠕⠝ ⠁⠋⠞⠑⠗ ⠉⠇⠑⠁⠝⠥⠏⠲ ⠠⠎⠑⠇⠑⠉⠞ ⠞⠓⠑ ⠙⠑⠎⠞⠊⠝⠁⠞⠊⠕⠝ ⠁⠛⠁⠊⠝⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Bereinigung ist ein anderes Objekt am Ziel erschienen. Wählen Sie das Ziel erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another item appeared at the destination after cleanup. Select the destination again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
