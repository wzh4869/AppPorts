        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用内容已更新或改變，不能用舊備份覆盖。请选择茼版本原版应用恢复，或苁官汸渠道重新安装；现有应用和備份均已保留。"
          }
