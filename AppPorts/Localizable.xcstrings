          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Auswurfstatus lässt sich nicht lesen. Die automatische Wiederherstellung ist pausiert. Versuchen Sie es erneut oder prüfen Sie die Protokolle."
          }
        },
        "en" : {
          "stringUnit" : {
