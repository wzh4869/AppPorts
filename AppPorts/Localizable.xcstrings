    "接手失败：%@\n将自动重试，也可以回退更新。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الاسترداد: %@\nستتم إعادة محاولة AppPorts تلقائيًا. يمكنك أيضًا استرجاع التحديث."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠗⠑⠉⠕⠧⠑⠗⠽ ⠋⠁⠊⠇⠑⠙⠒ %@\n⠠⠁⠏⠏⠠⠏⠕⠗⠞⠎ ⠺⠊⠇⠇ ⠗⠑⠞⠗⠽ ⠁⠥⠞⠕⠍⠁⠞⠊⠉⠁⠇⠇⠽⠲ ⠠⠽⠕⠥ ⠉⠁⠝ ⠁⠇⠎⠕ ⠗⠕⠇⠇ ⠃⠁⠉⠅ ⠞⠓⠑ ⠥⠏⠙⠁⠞⠑⠲"
