    "将应用和数据迁移到外部存储，保留本地入口，释放磁盘空间。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل التطبيقات والبيانات إلى وحدة تخزين خارجية مع الاحتفاظ بالوصول المحلي وتوفير مساحة على القرص."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠍⠕⠧⠑ ⠁⠏⠏⠎ ⠁⠝⠙ ⠙⠁⠞⠁ ⠞⠕ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑⠂ ⠅⠑⠑⠏ ⠇⠕⠉⠁⠇ ⠁⠉⠉⠑⠎⠎⠂ ⠁⠝⠙ ⠋⠗⠑⠑ ⠥⠏ ⠙⠊⠎⠅ ⠎⠏⠁⠉⠑⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps und Daten auf externe Speicher verschieben, den lokalen Zugriff behalten und Speicherplatz freigeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move apps and data to external storage, keep local access, and free up disk space."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movu aplikaĵojn kaj datumojn al ekstera memoro, konservu lokan aliron kaj liberigu diskospacon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve apps y datos a un almacenamiento externo, conserva el acceso local y libera espacio en disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez les apps et les données vers un stockage externe, conservez un accès local et libérez de l’espace disque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप और डेटा को बाहरी स्टोरेज में ले जाएँ, स्थानीय पहुँच बनाए रखें और डिस्क में जगह खाली करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindahkan aplikasi dan data ke penyimpanan eksternal, pertahankan akses lokal, dan kosongkan ruang disk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta app e dati su un dispositivo esterno, mantieni l’accesso locale e libera spazio su disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリとデータを外部ストレージに移行し、ローカルからのアクセスを維持しながらディスク容量を確保します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱과 데이터를 외부 저장 장치로 옮기고 로컬 접근을 유지하여 디스크 공간을 확보합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats apps en gegevens naar externe opslag, behoud lokale toegang en maak schijfruimte vrij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieś aplikacje i dane na dysk zewnętrzny, zachowaj lokalny dostęp i zwolnij miejsce na dysku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova apps e dados para armazenamento externo, mantenha o acesso local e liberte espaço em disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносите приложения и данные на внешний накопитель, сохраняя локальный доступ и освобождая место на диске."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายแอปและข้อมูลไปยังที่จัดเก็บข้อมูลภายนอก โดยยังเปิดจากเครื่องได้และเพิ่มพื้นที่ว่างบนดิสก์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
