          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस AppPorts की पहुँच की पुष्टि नहीं हो सकी: जाँच फ़ाइलें उपलब्ध नहीं हैं या पढ़ने में कोई अन्य त्रुटि हुई। सिस्टम सेटिंग्स में जाँचें।"
