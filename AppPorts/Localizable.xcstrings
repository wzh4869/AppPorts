          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das App-Objekt, die Version oder der Inhalt hat sich geändert. Die bisherige Bestätigung gilt nicht mehr. Prüfe die aktuelle App erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app object, version, or contents changed. The previous confirmation no longer applies. Inspect the current app again."
