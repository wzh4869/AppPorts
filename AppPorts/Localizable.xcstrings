    "未保存密码时，需要手动解锁；后台不会反复弹出密码框。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم تُحفظ كلمة السر، ستحتاج إلى إلغاء القفل يدويًا؛ لن يظهر طلب كلمة السر مرارًا في الخلفية."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠊⠋ ⠞⠓⠑ ⠏⠁⠎⠎⠺⠕⠗⠙ ⠊⠎⠝⠄⠞ ⠎⠁⠧⠑⠙⠂ ⠽⠕⠥⠄⠇⠇ ⠝⠑⠑⠙ ⠞⠕ ⠥⠝⠇⠕⠉⠅ ⠍⠁⠝⠥⠁⠇⠇⠽⠆ ⠃⠁⠉⠅⠛⠗⠕⠥⠝⠙ ⠞⠁⠎⠅⠎ ⠺⠕⠝⠄⠞ ⠅⠑⠑⠏ ⠏⠗⠕⠍⠏⠞⠊⠝⠛ ⠋⠕⠗ ⠊⠞⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne gespeichertes Passwort müssen Sie manuell entsperren; im Hintergrund erscheint die Passwortabfrage nicht wiederholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the password isn't saved, you'll need to unlock manually; background tasks won't keep prompting for it."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la pasvorto ne estas konservita, vi devos malŝlosi permane; fone la pasvorta fenestro ne ripetiĝos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no guardas la contraseña, tendrás que desbloquear el volumen manualmente; las tareas en segundo plano no volverán a pedirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le mot de passe n’est pas enregistré, vous devrez déverrouiller manuellement ; les tâches en arrière-plan ne redemanderont pas le mot de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड सहेजा न होने पर आपको मैन्युअल रूप से अनलॉक करना होगा; बैकग्राउंड में पासवर्ड बार-बार नहीं माँगा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kata sandi tidak disimpan, Anda harus membuka kuncinya secara manual; jendela kata sandi tidak akan berulang di latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la password non viene salvata, dovrai sbloccare manualmente; le attività in background non continueranno a chiederla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを保存しない場合は手動でロック解除が必要です。バックグラウンドでパスワード入力画面が繰り返し表示されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호를 저장하지 않으면 직접 잠금 해제해야 하며, 백그라운드에서 암호 입력창이 반복해서 나타나지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is het wachtwoord niet bewaard, dan moet je handmatig ontgrendelen; op de achtergrond verschijnt niet steeds opnieuw een wachtwoordvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli hasło nie zostanie zachowane, wolumin trzeba będzie odblokować ręcznie; w tle okno hasła nie będzie się powtarzać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a senha não for salva, será preciso desbloquear manualmente; as tarefas em segundo plano não ficam pedindo a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если пароль не сохранён, разблокировать том придётся вручную; в фоне запрос пароля повторяться не будет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าไม่ได้บันทึกรหัสผ่าน คุณต้องปลดล็อกเอง และระบบจะไม่ถามรหัสผ่านซ้ำ ๆ ในเบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola kaydedilmezse birimi elle açmanız gerekir; arka planda parola penceresi tekrar tekrar açılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không lưu mật khẩu, bạn cần tự mở khóa; tác vụ nền sẽ không liên tục hỏi mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未保存密码时，需要手动解锁；后台不会反复弹出密码框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未儲存密碼時，需要手動解鎖；背景作業不會反覆彈出密碼框。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
