        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본에 남은 파일을 대조하고 있습니다. 정리 조건에 맞는 파일만 삭제하며, 차이가 있으면 보존합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De resterende bestanden in de kopie worden gecontroleerd. Alleen bestanden die aan de opschoonvoorwaarden voldoen worden verwijderd; bij verschillen wordt het bestand bewaard."
          }
        },
        "pl" : {
