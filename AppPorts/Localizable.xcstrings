    "卸载外置卷。卸载后应用会看到空目录，请在拔盘前先退出应用" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلغاء تحميل وحدة التخزين الخارجية. سيرى التطبيق مجلدًا فارغًا بعد ذلك؛ أنهِ التطبيق قبل فصل القرص"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠥⠝⠍⠕⠥⠝⠞ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠧⠕⠇⠥⠍⠑⠲ ⠠⠞⠓⠑ ⠁⠏⠏ ⠺⠊⠇⠇ ⠎⠑⠑ ⠁⠝ ⠑⠍⠏⠞⠽ ⠙⠊⠗⠑⠉⠞⠕⠗⠽ ⠁⠋⠞⠑⠗⠺⠁⠗⠙⠎⠆ ⠟⠥⠊⠞ ⠞⠓⠑ ⠁⠏⠏ ⠃⠑⠋⠕⠗⠑ ⠥⠝⠏⠇⠥⠛⠛⠊⠝⠛ ⠞⠓⠑ ⠙⠗⠊⠧⠑"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das externe Volume aushängen. Danach sieht die App einen leeren Ordner. Beende die App, bevor du das Laufwerk trennst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unmount the external volume. The app will see an empty directory afterwards; quit the app before unplugging the drive"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmunti la eksteran volumon. Poste la aplikaĵo vidos malplenan dosierujon; fermu la aplikaĵon antaŭ ol malkonekti la diskon"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desmontar el volumen externo. Después, la app verá una carpeta vacía. Sal de la app antes de desconectar el disco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démonter le volume externe. L’app verra ensuite un dossier vide. Quittez l’app avant de débrancher le disque"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहरी वॉल्यूम अनमाउंट करें। इसके बाद ऐप को खाली डायरेक्ट्री दिखेगी। ड्राइव निकालने से पहले ऐप बंद करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepas volume eksternal. Setelah itu, app akan melihat direktori kosong; tutup app sebelum mencabut drive"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smonta il volume esterno. L’app vedrà una cartella vuota; esci dall’app prima di scollegare l’unità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部ボリュームのマウントを解除します。解除後、アプリには空のディレクトリが表示されます。ドライブを取り外す前にアプリを終了してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외장 볼륨을 마운트 해제합니다. 해제 후 앱에는 빈 디렉토리가 표시됩니다. 드라이브를 분리하기 전에 앱을 종료하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontkoppel het externe volume. De app ziet daarna een lege map; stop de app voordat je de schijf loskoppelt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmontuj wolumin zewnętrzny. Aplikacja będzie wtedy widzieć pusty folder. Zamknij ją przed odłączeniem dysku"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desmonta o volume externo. O app passará a ver uma pasta vazia; encerre o app antes de desconectar a unidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размонтировать внешний том. После этого приложение увидит пустую папку. Закройте приложение перед отключением накопителя"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลิกต่อเชื่อมดิสก์โวลุ่มภายนอก หลังจากนั้นแอปจะเห็นไดเรกทอรีว่าง โปรดออกจากแอปก่อนถอดไดรฟ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici birimi ayırın. Ardından uygulama boş bir klasör görür; diski çıkarmadan önce uygulamadan çıkın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngắt gắn kết ổ lưu trữ ngoài. Sau đó ứng dụng sẽ thấy thư mục trống; hãy thoát ứng dụng trước khi rút ổ đĩa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载外置卷。卸载后应用会看到空目录，请在拔盘前先退出应用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸載外接卷宗。卸載後應用程式只會看到空目錄；拔除磁碟前請先結束應用程式"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载外寘卷。卸载后应用会看到空目录，请在拔盤前先退絀应用"
          }
        }
      }
    },
    "卸载失败，可能有应用正在使用该目录：%@\n%@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر إلغاء التحميل، ربما لا يزال أحد التطبيقات يستخدم هذا المجلد: %@\n%@"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠥⠝⠍⠕⠥⠝⠞ ⠋⠁⠊⠇⠑⠙⠂ ⠁⠝ ⠁⠏⠏ ⠍⠁⠽ ⠎⠞⠊⠇⠇ ⠃⠑ ⠥⠎⠊⠝⠛ ⠞⠓⠊⠎ ⠙⠊⠗⠑⠉⠞⠕⠗⠽⠒ %@\n%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aushängen fehlgeschlagen. Möglicherweise verwendet eine App diesen Ordner: %@\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unmount failed, an app may still be using this directory: %@\n%@"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmuntado malsukcesis; aplikaĵo eble ankoraŭ uzas ĉi tiun dosierujon: %@\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo desmontar. Es posible que una app esté usando esta carpeta: %@\n%@"
