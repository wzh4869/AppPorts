    },
    "迁移后第一次打开「%@」时，系统会询问是否允许访问可移动宗卷，请点「允许」" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند فتح «%@» لأول مرة بعد الترحيل، سيسألك النظام عن السماح بالوصول إلى وحدات التخزين القابلة للإزالة. انقر على «السماح»"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠋⠊⠗⠎⠞ ⠞⠊⠍⠑ ⠽⠕⠥ ⠕⠏⠑⠝ “%@” ⠁⠋⠞⠑⠗ ⠍⠊⠛⠗⠁⠞⠊⠝⠛⠂ ⠍⠁⠉⠠⠕⠠⠎ ⠁⠎⠅⠎ ⠺⠓⠑⠞⠓⠑⠗ ⠊⠞ ⠍⠁⠽ ⠁⠉⠉⠑⠎⠎ ⠁ ⠗⠑⠍⠕⠧⠁⠃⠇⠑ ⠧⠕⠇⠥⠍⠑⠲ ⠠⠉⠇⠊⠉⠅ ⠠⠁⠇⠇⠕⠺⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du „%@“ nach der Migration erstmals öffnest, fragt macOS nach dem Zugriff auf Wechselmedien. Klicke auf „Erlauben“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time you open “%@” after migrating, macOS asks whether it may access a removable volume. Click Allow."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉe la unua malfermo de “%@” post migrado, la sistemo demandos ĉu permesi aliron al demeteblaj volumoj. Alklaku “Permesi”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez que abras «%@» tras la migración, el sistema te pedirá permiso para acceder a volúmenes extraíbles. Haz clic en «Permitir»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la première ouverture de « %@ » après la migration, le système demande l’autorisation d’accéder aux volumes amovibles. Cliquez sur « Autoriser »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइग्रेशन के बाद पहली बार “%@” खोलने पर सिस्टम हटाने योग्य वॉल्यूम ऐक्सेस करने की अनुमति माँगेगा। “अनुमति दें” पर क्लिक करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat pertama kali membuka “%@” setelah migrasi, sistem akan meminta izin mengakses volume yang dapat dilepas. Klik “Izinkan”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla prima apertura di “%@” dopo la migrazione, il sistema chiederà il permesso di accedere ai volumi rimovibili. Fai clic su “Consenti”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移行後、初めて「%@」を開くと、リムーバブルボリュームへのアクセスを許可するかどうかを尋ねられます。「許可」をクリックしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이그레이션 후 “%@”을(를) 처음 열면 시스템이 이동식 볼륨 접근을 허용할지 묻습니다. “허용”을 클릭하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je ‘%@’ voor het eerst na de migratie opent, vraagt het systeem toestemming voor toegang tot verwisselbare volumes. Klik op ‘Sta toe’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy pierwszym otwarciu „%@” po migracji system poprosi o dostęp do woluminów wymiennych. Kliknij „Pozwól”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na primeira vez que abrir “%@” após a migração, o sistema pedirá permissão para acessar volumes removíveis. Clique em “Permitir”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При первом открытии «%@» после переноса система запросит доступ к съёмным томам. Нажмите «Разрешить»"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิด “%@” ครั้งแรกหลังย้าย ระบบจะถามว่าอนุญาตให้เข้าถึงดิสก์โวลุ่มแบบถอดได้หรือไม่ โปรดคลิก “อนุญาต”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taşımadan sonra “%@” uygulamasını ilk açtığınızda sistem çıkarılabilir birimlere erişim izni ister. “İzin Ver”e tıklayın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần đầu mở “%@” sau khi di chuyển, hệ thống sẽ hỏi có cho phép truy cập ổ đĩa di động không. Hãy bấm “Cho phép”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迁移后第一次打开「%@」时，系统会询问是否允许访问可移动宗卷，请点「允许」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遷移後第一次打開「%@」時，系統會詢問是否允許取用可移除式卷宗，請按一下「允許」"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迁移后第一次打开「%@」時，繫統会询問是否允許訪問可移动宗卷，请点「允許」"
          }
        }
      }
    },
