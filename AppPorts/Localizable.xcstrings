    "用户取消了管理员授权，无法执行磁盘命令（%@）" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغى المستخدم منح صلاحيات المسؤول، لذا تعذر تنفيذ أمر القرص (%@)"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠙⠍⠊⠝⠊⠎⠞⠗⠁⠞⠕⠗ ⠁⠥⠞⠓⠕⠗⠊⠵⠁⠞⠊⠕⠝ ⠺⠁⠎ ⠉⠁⠝⠉⠑⠇⠇⠑⠙⠆ ⠙⠊⠎⠅ ⠉⠕⠍⠍⠁⠝⠙ ⠝⠕⠞ ⠗⠥⠝ ⠐⠣%@⠐⠜"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Administratorautorisierung wurde abgebrochen. Der Festplattenbefehl kann nicht ausgeführt werden (%@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator authorization was cancelled; disk command not run (%@)"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La uzanto nuligis administrantan rajtigon; ne eblas ruli la diskkomandon (%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El usuario canceló la autorización de administrador. No se puede ejecutar el comando de disco (%@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utilisateur a annulé l’autorisation administrateur. Impossible d’exécuter la commande disque (%@)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता ने ऐडमिनिस्ट्रेटर की अनुमति रद्द कर दी। डिस्क कमांड नहीं चलाया जा सकता (%@)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengguna membatalkan otorisasi administrator; perintah disk tidak dapat dijalankan (%@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utente ha annullato l’autorizzazione dell’amministratore. Impossibile eseguire il comando disco (%@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者認証がキャンセルされたため、ディスクコマンドを実行できません（%@）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 관리자 인증을 취소하여 디스크 명령을 실행할 수 없습니다(%@)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
