        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The listed materials were not found. The location may be offline or may have changed. The record has been kept; you can remove it after confirming that you have handled the materials yourself."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La listigitaj materialoj ne estis trovitaj; la loko eble estas eksterrete aŭ ŝanĝiĝis. La registro estis konservita; vi povas forigi ĝin post konfirmo, ke vi mem traktis la materialojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron los elementos indicados; es posible que la ubicación esté desconectada o haya cambiado. Se ha conservado el registro y puedes eliminarlo después de confirmar que te has encargado de estos elementos."
          }
