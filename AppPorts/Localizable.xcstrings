        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrado de la subskribostato de la originala aplikaĵo. Subskriboj, kiuj estis validaj, estos konfirmitaj post la kopiado."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrando el estado de firma de la app original. Las firmas que eran válidas se confirmarán después de copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
