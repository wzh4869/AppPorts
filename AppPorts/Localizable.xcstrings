        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migrado per muntado metas la datumojn de “%@” sur la eksteran konservilon, kiun vi elektas. Nenio ŝanĝiĝos antaŭ ol vi elektos lokon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La migración por montaje guarda los datos de «%@» en el almacenamiento externo que elijas. No se modificará nada hasta que selecciones una ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
