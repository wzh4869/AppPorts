    "存储位置已排除后，Spotlight 仍可能需要时间更新结果。" : {
      "comment" : "Search exclusion. English fallback for locales other than English and Simplified/Traditional Chinese; translations pending review.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد استبعاد موقع تخزين، قد يستغرق Spotlight بعض الوقت لتحديث النتائج."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠋⠞⠑⠗ ⠁ ⠇⠕⠉⠁⠞⠊⠕⠝ ⠊⠎ ⠑⠭⠉⠇⠥⠙⠑⠙⠂ ⠠⠎⠏⠕⠞⠇⠊⠛⠓⠞ ⠍⠁⠽ ⠎⠞⠊⠇⠇ ⠝⠑⠑⠙ ⠞⠊⠍⠑ ⠞⠕ ⠥⠏⠙⠁⠞⠑ ⠊⠞⠎ ⠗⠑⠎⠥⠇⠞⠎⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Ausschließen eines Speicherorts kann Spotlight einige Zeit brauchen, um die Ergebnisse zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a location is excluded, Spotlight may still need time to update its results."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post kiam loko estas ekskludita, Spotlight eble bezonos tempon por ĝisdatigi la rezultojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras excluir una ubicación, Spotlight aún puede tardar en actualizar los resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois un emplacement exclu, Spotlight peut encore mettre du temps à actualiser ses résultats."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी स्थान को बाहर रखने के बाद भी Spotlight को परिणाम अपडेट होने में समय लग सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
