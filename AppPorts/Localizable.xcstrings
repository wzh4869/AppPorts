        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kopieresultaat is gecontroleerd. Voordat de gegevenstoegang wordt gewijzigd, wordt bevestigd dat de bestanden die zo worden gebruikt compleet en ongewijzigd zijn."
