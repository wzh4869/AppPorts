    "取消请求已处理；已完成的迁移步骤不会撤销。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت معالجة طلب الإلغاء؛ لن تُلغى خطوات الترحيل المكتملة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠉⠁⠝⠉⠑⠇ ⠗⠑⠟⠥⠑⠎⠞ ⠺⠁⠎ ⠓⠁⠝⠙⠇⠑⠙⠆ ⠉⠕⠍⠏⠇⠑⠞⠑⠙ ⠍⠊⠛⠗⠁⠞⠊⠕⠝ ⠎⠞⠑⠏⠎ ⠁⠗⠑⠝’⠞ ⠥⠝⠙⠕⠝⠑⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abbruchanforderung wurde verarbeitet; bereits abgeschlossene Migrationsschritte werden nicht rückgängig gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cancel request was handled; completed migration steps aren’t undone."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuligpeto estis prilaborita; finitaj migraj paŝoj ne malfariĝas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud de cancelación se ha procesado; los pasos de migración ya completados no se deshacen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande d’annulation a été traitée ; les étapes de migration déjà terminées ne sont pas annulées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रद्द करने का अनुरोध संसाधित हो गया है; पूरे हो चुके माइग्रेशन चरण वापस नहीं किए जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan pembatalan telah diproses; langkah migrasi yang sudah selesai tidak dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta di annullamento è stata gestita; i passaggi di migrazione già completati non vengono annullati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル要求を処理しました。完了済みの移行ステップは取り消されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소 요청이 처리되었습니다. 이미 완료된 마이그레이션 단계는 되돌려지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het annuleringsverzoek is verwerkt; voltooide migratiestappen worden niet ongedaan gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądanie anulowania zostało obsłużone; ukończone kroki migracji nie zostaną cofnięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A solicitação de cancelamento foi processada; as etapas de migração já concluídas não são desfeitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос на отмену обработан; завершённые шаги переноса не отменяются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดำเนินการตามคำขอยกเลิกแล้ว ขั้นตอนการย้ายที่เสร็จแล้วจะไม่ถูกย้อนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İptal isteği işlendi; tamamlanmış taşıma adımları geri alınmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu hủy đã được xử lý; các bước di chuyển đã hoàn tất sẽ không bị hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消请求已处理；已完成的迁移步骤不会撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消要求已處理；已完成的遷移步驟不會撤銷。"
          }
        },
        "zh-martian" : {
