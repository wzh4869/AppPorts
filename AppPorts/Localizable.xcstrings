          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenvorgang ist noch nicht abgeschlossen; die vorhandenen Dateien wurden beibehalten. Beenden Sie die zugehörige App, verbinden und entsperren Sie das externe Laufwerk und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The data operation has not finished; the existing files have been kept. Quit the associated app, then connect and unlock the external drive, and retry."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La datuma operacio ankoraŭ ne finiĝis; la ekzistantaj dosieroj konserviĝis. Fermu la rilatan aplikaĵon, konektu kaj malŝlosu la eksteran diskon, poste reprovu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operación de datos no ha terminado y se han conservado los archivos existentes. Cierra la app asociada, conecta y desbloquea el disco externo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération sur les données n’est pas terminée ; les fichiers existants ont été conservés. Quittez l’app associée, connectez et déverrouillez le disque externe, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटा कार्रवाई पूरी नहीं हुई है, मौजूदा फ़ाइलें सुरक्षित रखी गई हैं। संबंधित ऐप बंद करें, बाहरी ड्राइव जोड़ें और अनलॉक करें, फिर दोबारा कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
