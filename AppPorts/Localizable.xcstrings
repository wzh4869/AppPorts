        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ nguyên: dữ liệu của “%@” tiếp tục ở trên máy Mac này, mọi thứ như cũ và bạn có thể di chuyển bất cứ lúc nào sau này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
