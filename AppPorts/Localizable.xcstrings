    "校验通过后清理所列历史副本，当前数据会保留。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال النسخ القديمة المدرجة بعد التحقق منها. ستُحفظ البيانات الحالية."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠇⠊⠎⠞⠑⠙ ⠓⠊⠎⠞⠕⠗⠊⠉⠁⠇ ⠉⠕⠏⠊⠑⠎ ⠺⠊⠇⠇ ⠃⠑ ⠗⠑⠍⠕⠧⠑⠙ ⠁⠋⠞⠑⠗ ⠧⠑⠗⠊⠋⠊⠉⠁⠞⠊⠕⠝⠲ ⠠⠽⠕⠥⠗ ⠉⠥⠗⠗⠑⠝⠞ ⠙⠁⠞⠁ ⠺⠊⠇⠇ ⠃⠑ ⠅⠑⠏⠞⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aufgeführten früheren Kopien werden nach der Prüfung entfernt. Die aktuellen Daten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The listed historical copies will be removed after verification. Your current data will be kept."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La listigitaj historiaj kopioj estos forigitaj post kontrolo. La nunaj datumoj estos konservitaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias históricas indicadas se eliminarán tras verificarlas. Se conservarán los datos actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciennes copies indiquées seront supprimées après vérification. Les données actuelles seront conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाँच के बाद सूचीबद्ध पुरानी प्रतियाँ हटा दी जाएँगी। वर्तमान डेटा रखा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan lama yang tercantum akan dihapus setelah diverifikasi. Data saat ini akan tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie storiche elencate verranno rimosse dopo la verifica. I dati attuali verranno conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧の過去のコピーを検証後に削除します。現在のデータは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록의 이전 복사본을 확인한 후 삭제합니다. 현재 데이터는 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vermelde oude kopieën worden na controle verwijderd. De huidige gegevens blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymienione starsze kopie zostaną usunięte po sprawdzeniu. Bieżące dane zostaną zachowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias históricas indicadas serão removidas após a verificação. Os dados atuais serão preservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указанные старые копии будут удалены после проверки. Текущие данные сохранятся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำเนาเก่าที่ระบุจะถูกลบหลังการตรวจสอบ ข้อมูลปัจจุบันจะยังคงอยู่"
