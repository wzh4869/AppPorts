          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्थायी डायरेक्टरी बनाने के बाद उसका स्वामित्व दर्ज नहीं हुआ। आप यह प्रयास रद्द करके डायरेक्टरी सुरक्षित रख सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepemilikan direktori sementara belum dicatat setelah dibuat. Anda dapat membatalkan percobaan ini dan mempertahankan direktorinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appartenenza della directory temporanea non è stata registrata dopo la creazione. Puoi annullare questo tentativo e conservare la directory."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時ディレクトリ作成後の所有関係が未記録です。ディレクトリを保持したまま試行をキャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임시 디렉터리 생성 후 소유 관계가 기록되지 않았습니다. 디렉터리를 보존한 채 시도를 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na het aanmaken van de tijdelijke map is de bijbehorende bewerking niet vastgelegd. U kunt deze poging annuleren en de map behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po utworzeniu katalogu tymczasowego nie zapisano jego przynależności. Możesz anulować tę próbę i zachować katalog."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pertencimento do diretório temporário não foi registrado após sua criação. Você pode cancelar esta tentativa e preservar o diretório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После создания временного каталога его принадлежность не была записана. Можно отменить попытку, сохранив каталог."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้บันทึกความเป็นเจ้าของหลังสร้างไดเรกทอรีชั่วคราว คุณสามารถยกเลิกความพยายามนี้และเก็บไดเรกทอรีไว้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçici dizin oluşturulduktan sonra aidiyeti kaydedilmedi. Dizini koruyarak bu denemeyi iptal edebilirsiniz."
