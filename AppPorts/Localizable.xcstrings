        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die vorbereitete Verknüpfung fehlt noch ein gespeicherter Zugehörigkeitsnachweis. Sie können den Versuch abbrechen und das Objekt behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The staged shortcut has no saved ownership record yet. You can cancel this attempt and keep the item."
