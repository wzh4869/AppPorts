        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn còn %lld thư mục bộ chứa trỏ đến ổ đĩa ngoài. Phải khôi phục trước khi cài lại, nếu không ứng dụng vẫn không đọc được dữ liệu sau khi cài lại."
          }
