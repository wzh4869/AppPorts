        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur aŭdovidaj dosieroj estas migrataj; datumbazoj kaj agordoj restas loke. Ĉu teksto-mesaĝoj funkcias sen la ekstera disko, dependas de via WeChat-versio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se migran los archivos multimedia; las bases de datos y la configuración se quedan en local. Sin el disco externo, la disponibilidad de los mensajes de texto depende de la versión de WeChat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les fichiers médias sont migrés ; les bases de données et la configuration restent en local. Sans le disque externe, la disponibilité des messages texte dépend de la version de WeChat."
          }
        },
        "hi" : {
          "stringUnit" : {
