    "应用不可写，无法完成重签名：%@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق غير قابل للكتابة، وتعذرت إعادة توقيعه: %@"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠞⠓⠑ ⠁⠏⠏⠇⠊⠉⠁⠞⠊⠕⠝ ⠊⠎ ⠝⠕⠞ ⠺⠗⠊⠞⠁⠃⠇⠑ ⠁⠝⠙ ⠉⠕⠥⠇⠙ ⠝⠕⠞ ⠃⠑ ⠗⠑-⠎⠊⠛⠝⠑⠙: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung ist nicht beschreibbar und konnte nicht neu signiert werden: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The application is not writable and could not be re-signed: %@"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplikaĵo ne estas skribebla kaj ne povis esti resubskribita: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación no permite escritura y no se pudo volver a firmar: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application n’est pas accessible en écriture et n’a pas pu être signée à nouveau : %@"
          }
        },
        "hi" : {
