        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफ़ाई के बाद गंतव्य पर कोई अन्य आइटम आ गया है। गंतव्य फिर से चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
