          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह बाहरी स्टोरेज एन्क्रिप्टेड नहीं है: ड्राइव खो जाने पर दूसरे लोग माइग्रेट किया गया डेटा पढ़ सकते हैं"
