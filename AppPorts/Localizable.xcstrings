      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تأكيد ما إذا كان القرص غير متصل. ما زال التحميل التلقائي متوقفاً مؤقتاً."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠥⠝⠁⠃⠇⠑ ⠞⠕ ⠙⠑⠞⠑⠗⠍⠊⠝⠑ ⠺⠓⠑⠞⠓⠑⠗ ⠞⠓⠑ ⠙⠊⠎⠅ ⠊⠎ ⠕⠋⠋⠇⠊⠝⠑⠲ ⠠⠁⠥⠞⠕⠍⠁⠞⠊⠉ ⠍⠕⠥⠝⠞⠊⠝⠛ ⠗⠑⠍⠁⠊⠝⠎ ⠏⠁⠥⠎⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lässt sich nicht bestätigen, ob der Datenträger offline ist. Das automatische Einhängen bleibt pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to determine whether the disk is offline. Automatic mounting remains paused."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne eblas konfirmi, ĉu la disko estas eksterreta. Aŭtomata muntado restas paŭzigita."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede confirmar si el disco está desconectado. El montaje automático sigue en pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer si le disque est hors ligne. Le montage automatique reste suspendu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क ऑफ़लाइन है या नहीं, इसकी पुष्टि नहीं हो सकी। अपने-आप माउंट करना अभी भी रुका हुआ है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memastikan apakah disk sedang offline. Pemasangan otomatis tetap dijeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile confermare se il disco è offline. Il montaggio automatico rimane sospeso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクがオフラインかどうか確認できません。自動マウントは引き続き一時停止中です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크가 오프라인 상태인지 확인할 수 없습니다. 자동 마운트는 계속 일시 정지 상태입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kan niet worden bevestigd of de schijf offline is. Automatisch koppelen blijft gepauzeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można potwierdzić, czy dysk jest offline. Automatyczne montowanie pozostaje wstrzymane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar se o disco está offline. A montagem automática continua em pausa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить, находится ли диск вне сети. Автоматическое подключение томов остаётся приостановленным."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถยืนยันได้ว่าดิสก์ออฟไลน์แล้วหรือไม่ การเมาท์อัตโนมัติยังคงหยุดชั่วคราว"
