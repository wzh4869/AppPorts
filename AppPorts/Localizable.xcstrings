    "已授权删除历史签名原件，清理尚未完成" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم السماح بحذف النسخة الأصلية الموقّعة السابقة. التنظيف غير مكتمل."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
