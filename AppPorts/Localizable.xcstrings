        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarigo ankoraŭ ne kreis kopion. Kontrolu la originan eniron kaj la eksterajn datumojn, poste malŝlosu por reprovi la restarigon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauración aún no ha creado ninguna copia. Comprueba la entrada original y los datos externos y desbloquea para volver a intentar la restauración."
