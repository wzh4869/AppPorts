          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un autre stockage externe au format APFS ou une partition APFS déjà présente sur ce disque"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरा APFS फ़ॉर्मैट वाला बाहरी स्टोरेज चुनें या इस ड्राइव पर मौजूद APFS विभाजन इस्तेमाल करें"
