          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुरानी प्रति नहीं खोली जा सकी। जाँचें कि डिस्क जुड़ी है और आपके पास पहुँच अनुमति है।"
