    "记录中的活动应用已被替换或磁盘尚未连接，保留所有旧副本。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم استبدال التطبيق النشط المسجل أو أن قرصه غير متصل. تم الاحتفاظ بجميع النسخ القديمة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠗⠑⠉⠕⠗⠙⠑⠙ ⠁⠉⠞⠊⠧⠑ ⠁⠏⠏ ⠓⠁⠎ ⠃⠑⠑⠝ ⠗⠑⠏⠇⠁⠉⠑⠙ ⠕⠗ ⠊⠞⠎ ⠙⠊⠎⠅ ⠊⠎ ⠙⠊⠎⠉⠕⠝⠝⠑⠉⠞⠑⠙⠲ ⠠⠁⠇⠇ ⠕⠇⠙ ⠉⠕⠏⠊⠑⠎ ⠺⠑⠗⠑ ⠅⠑⠏⠞⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erfasste aktive App wurde ersetzt oder ihr Laufwerk ist nicht verbunden. Alle alten Kopien wurden behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recorded active app has been replaced or its disk is disconnected. All old copies were kept."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrita aktiva aplikaĵo estis anstataŭigita aŭ ĝia disko estas malkonektita. Ĉiuj malnovaj kopioj estis konservitaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app activa registrada fue reemplazada o su disco está desconectado. Se conservaron todas las copias anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app active enregistrée a été remplacée ou son disque est déconnecté. Toutes les anciennes copies ont été conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्ड में दर्ज सक्रिय ऐप बदल दिया गया है या उसकी डिस्क जुड़ी नहीं है। सभी पुरानी प्रतियाँ सुरक्षित रखी गई हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi aktif yang tercatat telah diganti atau disknya belum tersambung. Semua salinan lama dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app attiva registrata è stata sostituita o il suo disco non è collegato. Tutte le vecchie copie sono state conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録された使用中のアプリが置き換わったか、ディスクが未接続です。古いコピーはすべて保持しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록된 활성 앱이 교체되었거나 디스크가 연결되지 않았습니다. 모든 이전 복사본을 보존했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geregistreerde actieve app is vervangen of de schijf is niet verbonden. Alle oude kopieën zijn bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisana aktywna aplikacja została zastąpiona lub jej dysk jest odłączony. Zachowano wszystkie stare kopie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app ativo registrado foi substituído ou seu disco está desconectado. Todas as cópias antigas foram preservadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записанное активное приложение заменено или его диск отключён. Все старые копии сохранены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปที่ใช้งานตามบันทึกถูกแทนที่ หรือยังไม่ได้เชื่อมต่อดิสก์ เก็บสำเนาเก่าทั้งหมดไว้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı etkin uygulama değiştirilmiş veya diski bağlı değil. Tüm eski kopyalar korundu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đang hoạt động trong bản ghi đã bị thay thế hoặc ổ đĩa chưa kết nối. Tất cả bản sao cũ đã được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录中的活动应用已被替换或磁盘尚未连接，保留所有旧副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄中的使用中應用程式已被替換或磁碟尚未連接，已保留所有舊副本。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
