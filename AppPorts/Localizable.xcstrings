            "value" : "Suitdosierujoj povas enhavi dokumentojn, do ili ne estas aŭtomate ekskluditaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas de suites pueden contener documentos y no se excluyen automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers de suites peuvent contenir des documents et ne sont pas exclus automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूट फ़ोल्डरों में दस्तावेज़ हो सकते हैं, इसलिए इन्हें स्वचालित रूप से बहिष्कृत नहीं किया जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder suite mungkin berisi dokumen, jadi tidak dikecualikan secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle suite possono contenere documenti e non vengono escluse automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイートフォルダには書類が含まれる可能性があるため、自動では除外しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스위트 폴더에는 문서가 포함될 수 있어 자동으로 제외하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suite-mappen kunnen documenten bevatten en worden niet automatisch uitgesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldery pakietów mogą zawierać dokumenty, więc nie są automatycznie wykluczane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastas de suítes podem conter documentos e não são excluídas automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папки наборов могут содержать документы, поэтому не исключаются автоматически."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์ชุดแอปอาจมีเอกสารอยู่ จึงไม่ถูกยกเว้นโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
