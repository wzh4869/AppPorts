      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وحدة التخزين التي تحتوي على النسخة القديمة غير محمّلة. وصّل القرص الخارجي، ثم ألغِ قفله وحمّله في «أدوات القرص» وأعد الفتح."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠧⠕⠇⠥⠍⠑ ⠓⠕⠇⠙⠊⠝⠛ ⠞⠓⠑ ⠕⠇⠙ ⠉⠕⠏⠽ ⠊⠎⠝’⠞ ⠍⠕⠥⠝⠞⠑⠙⠲ ⠠⠉⠕⠝⠝⠑⠉⠞ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠙⠗⠊⠧⠑⠂ ⠞⠓⠑⠝ ⠥⠝⠇⠕⠉⠅ ⠁⠝⠙ ⠍⠕⠥⠝⠞ ⠊⠞ ⠊⠝ ⠠⠙⠊⠎⠅ ⠠⠥⠞⠊⠇⠊⠞⠽ ⠁⠝⠙ ⠕⠏⠑⠝ ⠊⠞ ⠁⠛⠁⠊⠝⠲"
