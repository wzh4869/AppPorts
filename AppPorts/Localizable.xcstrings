    "推荐做法是把外置盘格式化成 APFS 并使用挂载迁移，签名不需要任何改动。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنصح بتهيئة القرص الخارجي بتنسيق APFS واستخدام الترحيل بالتحميل، دون الحاجة إلى أي تغيير في التوقيع."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠗⠑⠉⠕⠍⠍⠑⠝⠙⠑⠙ ⠁⠏⠏⠗⠕⠁⠉⠓ ⠊⠎ ⠞⠕ ⠋⠕⠗⠍⠁⠞ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠙⠗⠊⠧⠑ ⠁⠎ ⠠⠁⠠⠏⠠⠋⠠⠎ ⠁⠝⠙ ⠥⠎⠑ ⠍⠕⠥⠝⠞ ⠍⠊⠛⠗⠁⠞⠊⠕⠝⠂ ⠺⠓⠊⠉⠓ ⠗⠑⠟⠥⠊⠗⠑⠎ ⠝⠕ ⠎⠊⠛⠝⠁⠞⠥⠗⠑ ⠉⠓⠁⠝⠛⠑⠎⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfohlen wird, das externe Laufwerk als APFS zu formatieren und die Mount-Migration zu verwenden. Dabei muss die Signatur nicht geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recommended approach is to format the external drive as APFS and use mount migration, which requires no signature changes."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas rekomendate formati la eksteran diskon kiel APFS kaj uzi migradon per muntado; neniu ŝanĝo al la subskribo necesas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recomienda formatear el disco externo como APFS y usar la migración por montaje. No es necesario modificar la firma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est recommandé de formater le disque externe en APFS et d’utiliser la migration par montage. La signature n’a pas besoin d’être modifiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहरी ड्राइव को APFS में फ़ॉर्मैट करके माउंट द्वारा माइग्रेशन इस्तेमाल करना सुझाया जाता है। हस्ताक्षर में किसी बदलाव की ज़रूरत नहीं होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebaiknya format drive eksternal sebagai APFS dan gunakan migrasi dengan pemasangan, tanpa perlu mengubah tanda tangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È consigliato formattare l’unità esterna in APFS e usare la migrazione tramite montaggio. Non serve modificare la firma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめは、外部ドライブを APFS でフォーマットしてマウント移行を使う方法です。署名には一切手を加えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외장 드라이브를 APFS로 포맷하고 마운트 마이그레이션을 사용하는 것이 좋습니다. 서명은 변경할 필요가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt aanbevolen de externe schijf als APFS te formatteren en migratie via aankoppelen te gebruiken. De handtekening hoeft niet te worden gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalecamy sformatowanie dysku zewnętrznego jako APFS i użycie migracji przez montowanie. Podpis nie wymaga żadnych zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomendamos formatar a unidade externa como APFS e usar a migração por montagem. Não é necessário alterar a assinatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендуется отформатировать внешний накопитель в APFS и использовать перенос с монтированием. Подпись изменять не потребуется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แนะนำให้ฟอร์แมตไดรฟ์ภายนอกเป็น APFS แล้วใช้การย้ายแบบต่อเชื่อม โดยไม่จำเป็นต้องเปลี่ยนลายเซ็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici diski APFS olarak biçimlendirip bağlayarak taşıma kullanmanız önerilir. İmzayı değiştirmeniz gerekmez."
          }
        },
        "vi" : {
