    "没有旧版恢复备份。请选择同版本官方原件，或从官方渠道重新安装。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر نسخة احتياطية قديمة للاستعادة. اختر نسخة أصلية رسمية من الإصدار نفسه أو أعد التثبيت من مصدر رسمي."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠝⠕ ⠇⠑⠛⠁⠉⠽ ⠗⠑⠉⠕⠧⠑⠗⠽ ⠃⠁⠉⠅⠥⠏ ⠊⠎ ⠁⠧⠁⠊⠇⠁⠃⠇⠑⠲ ⠠⠎⠑⠇⠑⠉⠞ ⠁⠝ ⠕⠋⠋⠊⠉⠊⠁⠇ ⠕⠗⠊⠛⠊⠝⠁⠇ ⠕⠋ ⠞⠓⠑ ⠎⠁⠍⠑ ⠧⠑⠗⠎⠊⠕⠝⠂ ⠕⠗ ⠗⠑⠊⠝⠎⠞⠁⠇⠇ ⠋⠗⠕⠍ ⠁⠝ ⠕⠋⠋⠊⠉⠊⠁⠇ ⠎⠕⠥⠗⠉⠑⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine ältere Wiederherstellungssicherung. Wähle ein offizielles Original derselben Version oder installiere die App aus einer offiziellen Quelle neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No legacy recovery backup is available. Select an official original of the same version, or reinstall from an official source."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne disponeblas malnova restaŭra sekurkopio. Elektu oficialan originalon de la sama versio aŭ reinstalu el oficiala fonto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay una copia de recuperación antigua. Selecciona un original oficial de la misma versión o reinstala desde una fuente oficial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune ancienne sauvegarde de restauration n’est disponible. Choisissez un original officiel de la même version ou réinstallez depuis une source officielle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहाली का कोई पुराना बैकअप उपलब्ध नहीं है। उसी संस्करण की आधिकारिक मूल प्रति चुनें या आधिकारिक स्रोत से फिर से इंस्टॉल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada cadangan pemulihan lama. Pilih salinan asli resmi dengan versi yang sama atau instal ulang dari sumber resmi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è disponibile un vecchio backup di ripristino. Seleziona un originale ufficiale della stessa versione o reinstalla da una fonte ufficiale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧版の復元用バックアップはありません。同じバージョンの公式オリジナルを選択するか、公式の配布元から再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 복구 백업이 없습니다. 같은 버전의 공식 원본을 선택하거나 공식 출처에서 다시 설치하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen oude herstelreservekopie beschikbaar. Selecteer een officieel origineel van dezelfde versie of installeer opnieuw via een officiële bron."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak starszej kopii zapasowej do przywracania. Wybierz oficjalny oryginał tej samej wersji lub zainstaluj ponownie z oficjalnego źródła."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há um backup antigo de recuperação disponível. Selecione um original oficial da mesma versão ou reinstale a partir de uma fonte oficial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старая резервная копия для восстановления отсутствует. Выберите официальный оригинал той же версии или переустановите приложение из официального источника."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีข้อมูลสำรองการกู้คืนรุ่นเก่า โปรดเลือกต้นฉบับทางการของเวอร์ชันเดียวกัน หรือติดตั้งใหม่จากแหล่งทางการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski bir kurtarma yedeği yok. Aynı sürümün resmî özgün kopyasını seçin veya resmî kaynaktan yeniden yükleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có bản sao lưu khôi phục cũ. Hãy chọn bản gốc chính thức cùng phiên bản hoặc cài đặt lại từ nguồn chính thức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有旧版恢复备份。请选择同版本官方原件，或从官方渠道重新安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有舊版恢復備份。請選擇相同版本的官方原件，或從官方來源重新安裝。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有舊版恢復備份。請選擇相同版本的官方原件，或從官方來源偅噺安裝。"
          }
        }
      }
    },
    "没有足够的原开发者身份事实来证明此次恢复。请通过官方更新或重新安装恢复官方状态；应用数据不会被本操作覆盖。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد أدلة كافية على هوية المطوّر الأصلي للتحقق من هذه الاستعادة. استخدم تحديثًا رسميًا أو أعد التثبيت لاستعادة التطبيق الرسمي. لن تستبدل هذه العملية بيانات التطبيق."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑⠗⠑ ⠊⠎ ⠊⠝⠎⠥⠋⠋⠊⠉⠊⠑⠝⠞ ⠑⠧⠊⠙⠑⠝⠉⠑ ⠕⠋ ⠞⠓⠑ ⠕⠗⠊⠛⠊⠝⠁⠇ ⠙⠑⠧⠑⠇⠕⠏⠑⠗⠄⠎ ⠊⠙⠑⠝⠞⠊⠞⠽ ⠞⠕ ⠧⠑⠗⠊⠋⠽ ⠞⠓⠊⠎ ⠗⠑⠎⠞⠕⠗⠁⠞⠊⠕⠝⠲ ⠠⠥⠎⠑ ⠁⠝ ⠕⠋⠋⠊⠉⠊⠁⠇ ⠥⠏⠙⠁⠞⠑ ⠕⠗ ⠗⠑⠊⠝⠎⠞⠁⠇⠇ ⠞⠕ ⠗⠑⠎⠞⠕⠗⠑ ⠞⠓⠑ ⠕⠋⠋⠊⠉⠊⠁⠇ ⠁⠏⠏⠲ ⠠⠞⠓⠊⠎ ⠕⠏⠑⠗⠁⠞⠊⠕⠝ ⠙⠕⠑⠎ ⠝⠕⠞ ⠕⠧⠑⠗⠺⠗⠊⠞⠑ ⠁⠏⠏ ⠙⠁⠞⠁⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ursprüngliche Entwickleridentität ist nicht ausreichend belegt, um diese Wiederherstellung zu bestätigen. Verwende ein offizielles Update oder eine Neuinstallation. App-Daten werden dabei nicht überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is insufficient evidence of the original developer's identity to verify this restoration. Use an official update or reinstall to restore the official app. This operation does not overwrite app data."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ekzistas sufiĉaj pruvoj pri la identeco de la originala programisto por kontroli ĉi tiun restarigon. Uzu oficialan ĝisdatigon aŭ reinstalon. Ĉi tiu operacio ne anstataŭigas la datumojn de la aplikaĵo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay pruebas suficientes de la identidad del desarrollador original para verificar esta restauración. Usa una actualización oficial o reinstala la aplicación. Esta operación no sobrescribe los datos de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identité du développeur d’origine n’est pas suffisamment établie pour valider cette restauration. Utilisez une mise à jour officielle ou réinstallez l’application. Cette opération n’écrase pas les données de l’application."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बहाली को सत्यापित करने के लिए मूल डेवलपर की पहचान के पर्याप्त प्रमाण नहीं हैं। आधिकारिक अपडेट या पुनः इंस्टॉलेशन का उपयोग करें। इस कार्रवाई से ऐप का डेटा ओवरराइट नहीं होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukti identitas pengembang asli tidak cukup untuk memverifikasi pemulihan ini. Gunakan pembaruan resmi atau instal ulang untuk memulihkan aplikasi resmi. Operasi ini tidak menimpa data aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono prove sufficienti dell’identità dello sviluppatore originale per verificare questo ripristino. Usa un aggiornamento ufficiale o reinstalla l’app. Questa operazione non sovrascrive i dati dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の開発者の識別情報が不足しているため、この復元を検証できません。公式アップデートまたは再インストールで公式の状態に戻してください。この操作でアプリのデータが上書きされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 복원을 검증할 원래 개발자의 신원 정보가 충분하지 않습니다. 공식 업데이트 또는 재설치를 통해 공식 상태로 복원하세요. 이 작업은 앱 데이터를 덮어쓰지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is onvoldoende bewijs van de oorspronkelijke ontwikkelaarsidentiteit om dit herstel te verifiëren. Gebruik een officiële update of installeer opnieuw. Deze bewerking overschrijft geen appgegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak wystarczających dowodów tożsamości pierwotnego dewelopera, by zweryfikować to przywracanie. Użyj oficjalnej aktualizacji lub zainstaluj aplikację ponownie. Ta operacja nie nadpisuje danych aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há evidências suficientes da identidade do desenvolvedor original para verificar esta restauração. Use uma atualização oficial ou reinstale o aplicativo. Esta operação não substitui os dados do aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно сведений об исходном разработчике, чтобы подтвердить это восстановление. Используйте официальное обновление или переустановку. Эта операция не перезаписывает данные приложения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีหลักฐานข้อมูลประจำตัวของนักพัฒนาเดิมเพียงพอที่จะยืนยันการกู้คืนนี้ โปรดใช้อัปเดตทางการหรือติดตั้งใหม่เพื่อคืนแอปทางการ การดำเนินการนี้จะไม่เขียนทับข้อมูลแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu geri yüklemeyi doğrulayacak yeterli özgün geliştirici kimliği kanıtı yok. Resmî güncellemeyi kullanın veya uygulamayı yeniden yükleyin. Bu işlem uygulama verilerinin üzerine yazmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có đủ bằng chứng về danh tính nhà phát triển gốc để xác minh lần khôi phục này. Hãy dùng bản cập nhật chính thức hoặc cài đặt lại. Thao tác này không ghi đè dữ liệu ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有足够的原开发者身份事实来证明此次恢复。请通过官方更新或重新安装恢复官方状态；应用数据不会被本操作覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有足夠的原開發者身分資訊來驗證此次恢復。請透過官方更新或重新安裝恢復官方狀態；此操作不會覆寫應用程式資料。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有足夠的原開發鍺身份資訊來驗證此次恢復。請透過官方更新或偅噺安裝恢復官方狀態；此操莋不會覆寫應苚程鉽資炓。"
          }
        }
      }
    },
    "没有需要更新的 Dock 固定项。如果还未固定此应用，请打开应用后选择“在程序坞中保留”。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد عناصر في Dock تحتاج إلى تحديث. إذا لم يكن هذا التطبيق مثبّتًا بعد، فافتحه واختر «احتفاظ في شريط الأيقونات»."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠝⠕ ⠠⠙⠕⠉⠅ ⠊⠞⠑⠍⠎ ⠝⠑⠑⠙ ⠥⠏⠙⠁⠞⠊⠝⠛⠲ ⠠⠊⠋ ⠞⠓⠊⠎ ⠁⠏⠏ ⠊⠎ ⠝⠕⠞ ⠏⠊⠝⠝⠑⠙ ⠽⠑⠞⠂ ⠕⠏⠑⠝ ⠊⠞ ⠁⠝⠙ ⠉⠓⠕⠕⠎⠑ ⠦⠠⠅⠑⠑⠏ ⠊⠝ ⠠⠙⠕⠉⠅⠴⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Dock-Einträge müssen aktualisiert werden. Falls diese App noch nicht im Dock ist, öffnen Sie sie und wählen Sie „Im Dock behalten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Dock items need updating. If this app is not pinned yet, open it and choose “Keep in Dock”."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neniu ero en Dock bezonas ĝisdatigon. Se ĉi tiu aplikaĵo ankoraŭ ne estas fiksita, malfermu ĝin kaj elektu “Konservi en Dock”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
