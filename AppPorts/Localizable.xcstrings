    "Choose external storage in AppPorts before configuring App Store external installation." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر وحدة تخزين خارجية في AppPorts أولًا قبل إعداد التثبيت الخارجي لـ App Store."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠉⠓⠕⠕⠎⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑ ⠊⠝ ⠠⠁⠏⠏⠠⠏⠕⠗⠞⠎ ⠃⠑⠋⠕⠗⠑ ⠉⠕⠝⠋⠊⠛⠥⠗⠊⠝⠛ ⠠⠁⠏⠏ ⠠⠎⠞⠕⠗⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠊⠝⠎⠞⠁⠇⠇⠁⠞⠊⠕⠝⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle zuerst in AppPorts einen externen Speicher aus, bevor du die externe App Store-Installation konfigurierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose external storage in AppPorts before configuring App Store external installation."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unue elektu eksteran konservejon en AppPorts antaŭ ol agordi eksteran instaladon de App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige primero un almacenamiento externo en AppPorts antes de configurar la instalación externa de App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez d’abord un stockage externe dans AppPorts avant de configurer l’installation externe de l’App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store बाहरी इंस्टॉलेशन कॉन्फ़िगर करने से पहले AppPorts में बाहरी स्टोरेज चुनें।"
