        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użytkownik anulował autoryzację administratora. Nie można wykonać polecenia dyskowego (%@)"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
