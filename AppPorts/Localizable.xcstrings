    "账号下的 msg 和 business 必须都是可读取的真实目录，才能拆分迁移。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون مجلدا msg وbusiness في الحساب مجلدين حقيقيين قابلين للقراءة لاستخدام الترحيل المنقسم."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠁⠉⠉⠕⠥⠝⠞’⠎ ⠍⠎⠛ ⠁⠝⠙ ⠃⠥⠎⠊⠝⠑⠎⠎ ⠋⠕⠇⠙⠑⠗⠎ ⠍⠥⠎⠞ ⠃⠕⠞⠓ ⠃⠑ ⠗⠑⠁⠙⠁⠃⠇⠑ ⠙⠊⠗⠑⠉⠞⠕⠗⠊⠑⠎ ⠞⠕ ⠥⠎⠑ ⠎⠏⠇⠊⠞ ⠍⠊⠛⠗⠁⠞⠊⠕⠝⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ordner msg und business des Kontos müssen echte, lesbare Ordner sein, damit die Split-Migration möglich ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account’s msg and business folders must both be readable directories to use split migration."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dosierujoj msg kaj business de la konto devas esti ambaŭ realaj, legeblaj dosierujoj por uzi dividan migradon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas msg y business de la cuenta deben ser directorios reales y legibles para usar la migración dividida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers msg et business du compte doivent être des dossiers réels et lisibles pour utiliser la migration scindée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विभाजित माइग्रेशन के लिए खाते के msg और business दोनों पढ़ने योग्य वास्तविक फ़ोल्डर होने चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder msg dan business pada akun harus keduanya berupa folder nyata yang dapat dibaca agar migrasi terpisah dapat digunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle msg e business dell’account devono essere cartelle reali e leggibili per usare la migrazione separata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント内の msg と business がどちらも読み取り可能な実フォルダである場合にのみ、分割移行を使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정의 msg와 business가 모두 읽을 수 있는 실제 폴더여야 분할 마이그레이션을 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De mappen msg en business van het account moeten beide echte, leesbare mappen zijn om gesplitste migratie te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby użyć migracji dzielonej, foldery msg i business konta muszą być rzeczywistymi, czytelnymi katalogami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pastas msg e business da conta precisam ser pastas reais e legíveis para usar a migração dividida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папки msg и business аккаунта должны быть настоящими доступными для чтения каталогами, иначе раздельный перенос невозможен."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์ msg และ business ของบัญชีต้องเป็นโฟลเดอร์จริงที่อ่านได้ทั้งคู่ จึงจะใช้การย้ายแบบแยกส่วนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölünmüş taşımayı kullanmak için hesabın msg ve business klasörlerinin ikisi de okunabilir gerçek klasörler olmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục msg và business của tài khoản đều phải là thư mục thật, đọc được thì mới dùng được di chuyển tách riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账号下的 msg 和 business 必须都是可读取的真实目录，才能拆分迁移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳號下的 msg 和 business 必須都是可讀取的實際目錄，才能拆分遷移。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账号下の msg 啝 business 必须都是岢讀取の真實目錄，才能拆汾遷迻。"
          }
        }
      }
    },
