          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the record was removed. Files and volumes were left unchanged, and no storage space was freed."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur la registro estis forigita. Dosieroj kaj volumoj restis senŝanĝaj, kaj ĉi tiu operacio liberigis neniun konservan spacon."
