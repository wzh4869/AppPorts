        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng vẫn bị giới hạn bởi vùng cô lập có thể không đọc được vị trí liên kết. Việc chuyển không tự động ký lại; chỉ chuyển dữ liệu chưa xác minh được tính tương thích của ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍受沙盒限制的应用可能无法读取链接位置。迁移不会自动重签；仅搬完数据不代表应用兼容性已验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
