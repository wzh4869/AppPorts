    "暂存入口已改变，未切换应用。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الاختصار المُجهز. لم يتم تبديل موقع التطبيق."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠎⠞⠁⠛⠑⠙ ⠎⠓⠕⠗⠞⠉⠥⠞ ⠓⠁⠎ ⠉⠓⠁⠝⠛⠑⠙⠲ ⠠⠞⠓⠑ ⠁⠏⠏ ⠇⠕⠉⠁⠞⠊⠕⠝ ⠺⠁⠎ ⠝⠕⠞ ⠎⠺⠊⠞⠉⠓⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vorbereitete Verknüpfung hat sich geändert. Der App-Speicherort wurde nicht umgestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The staged shortcut has changed. The app location was not switched."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preparita ŝparvojo ŝanĝiĝis. La aplikaĵa loko ne estis ŝanĝita."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso directo temporal ha cambiado. No se cambió la ubicación de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci temporaire a changé. L’emplacement de l’app n’a pas été basculé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तैयार किया गया शॉर्टकट बदल गया है। ऐप का स्थान नहीं बदला गया।"
          }
        },
        "id" : {
