          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il registro di migrazione. I dati e i registri sono conservati; non sono state apportate altre modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移行記録を読み取れません。データと記録は保持され、それ以上の変更はしていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이그레이션 기록을 읽을 수 없습니다. 데이터와 기록은 보존되며 추가 변경은 하지 않았습니다."
          }
        },
        "nl" : {
