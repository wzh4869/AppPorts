        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izolita aplikaĵo: ujaj datumoj povas iri al ekstera konservilo nur per migrado per muntado; la sistemo rifuzas simbolajn ligilojn"
