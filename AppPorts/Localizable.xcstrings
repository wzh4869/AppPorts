    "Settings: You can complete this later in AppPorts Settings, even after choosing “Don’t remind me again”." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات: يمكنك إكمال هذا الإجراء لاحقًا من إعدادات AppPorts حتى بعد اختيار «عدم التذكير مرة أخرى»."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠎⠑⠞⠞⠊⠝⠛⠎⠒ ⠠⠽⠕⠥ ⠉⠁⠝ ⠉⠕⠍⠏⠇⠑⠞⠑ ⠞⠓⠊⠎ ⠇⠁⠞⠑⠗ ⠊⠝ ⠠⠁⠏⠏⠠⠏⠕⠗⠞⠎ ⠠⠎⠑⠞⠞⠊⠝⠛⠎⠂ ⠑⠧⠑⠝ ⠁⠋⠞⠑⠗ ⠉⠓⠕⠕⠎⠊⠝⠛ “⠠⠙⠕⠝⠄⠞ ⠗⠑⠍⠊⠝⠙ ⠍⠑ ⠁⠛⠁⠊⠝”⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen: Du kannst dies später jederzeit in den AppPorts-Einstellungen nachholen, selbst wenn du „Nicht mehr erinnern“ auswählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings: You can complete this later in AppPorts Settings, even after choosing “Don’t remind me again”."
