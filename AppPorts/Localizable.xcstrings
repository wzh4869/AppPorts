        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op deze bestemming staat nog een oude kopie die moet worden opgeruimd. Probeer de oorspronkelijke overdracht opnieuw in Kopieën beheren voordat u deze bestemming opnieuw selecteert."
