        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La konservitaj materialoj ankoraŭ troviĝas ĉe la listigitaj lokoj. Vi povas administri ilin en Finder aŭ forigi nur ĉi tiun registron."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
