    "将「%@」从外置卷复制回本地，然后删除外置卷「%@」。\n\n还原到：%@\n\n还原需要外部存储保持连接，完成后外置卷及其数据会被删除。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ «%@» من وحدة التخزين الخارجية إلى هذا الـ Mac، ثم حذف وحدة التخزين الخارجية «%@».\n\nالاستعادة إلى: %@\n\nيجب إبقاء التخزين الخارجي متصلًا أثناء الاستعادة؛ ستُحذف وحدة التخزين الخارجية وبياناتها عند الانتهاء."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠉⠕⠏⠽ \"%@\" ⠋⠗⠕⠍ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠧⠕⠇⠥⠍⠑ ⠃⠁⠉⠅ ⠞⠕ ⠞⠓⠊⠎ ⠠⠍⠁⠉⠂ ⠞⠓⠑⠝ ⠙⠑⠇⠑⠞⠑ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠧⠕⠇⠥⠍⠑ \"%@\"⠲\n\n⠠⠗⠑⠎⠞⠕⠗⠑ ⠞⠕⠒ %@\n\n⠠⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑ ⠍⠥⠎⠞ ⠎⠞⠁⠽ ⠉⠕⠝⠝⠑⠉⠞⠑⠙⠆ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠧⠕⠇⠥⠍⠑ ⠁⠝⠙ ⠊⠞⠎ ⠙⠁⠞⠁ ⠁⠗⠑ ⠙⠑⠇⠑⠞⠑⠙ ⠺⠓⠑⠝ ⠙⠕⠝⠑⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ vom externen Volume zurück auf diesen Mac kopieren und anschließend das externe Volume „%@“ löschen.\n\nWiederherstellen unter: %@\n\nDer externe Speicher muss während der Wiederherstellung verbunden bleiben. Nach Abschluss werden das externe Volume und seine Daten gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy \"%@\" from the external volume back to this Mac, then delete the external volume \"%@\".\n\nRestore to: %@\n\nThe external storage must stay connected; the external volume and its data are deleted when done."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopii “%@” de la ekstera volumo al ĉi tiu Mac, poste forigi la eksteran volumon “%@”.\n\nRestarigi ĉe: %@\n\nLa ekstera konservilo devas resti konektita dum la restarigo; la ekstera volumo kaj ĝiaj datumoj estos forigitaj post la fino."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar «%@» del volumen externo a este Mac y después eliminar el volumen externo «%@».\n\nRestaurar en: %@\n\nEl almacenamiento externo debe permanecer conectado durante la restauración. Al finalizar, se eliminarán el volumen externo y sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier « %@ » du volume externe vers ce Mac, puis supprimer le volume externe « %@ ».\n\nRestaurer vers : %@\n\nLe stockage externe doit rester connecté pendant la restauration. Une fois celle-ci terminée, le volume externe et ses données seront supprimés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” को बाहरी वॉल्यूम से इस Mac पर कॉपी करें, फिर बाहरी वॉल्यूम “%@” डिलीट करें।\n\nयहाँ पुनर्स्थापित करें: %@\n\nपुनर्स्थापन के दौरान बाहरी स्टोरेज जुड़ा रहना चाहिए। पूरा होने पर बाहरी वॉल्यूम और उसका डेटा डिलीट हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin “%@” dari volume eksternal kembali ke Mac ini, lalu hapus volume eksternal “%@”.\n\nPulihkan ke: %@\n\nPenyimpanan eksternal harus tetap terhubung selama pemulihan. Volume eksternal dan datanya akan dihapus setelah selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia “%@” dal volume esterno sul Mac, poi elimina il volume esterno “%@”.\n\nRipristina in: %@\n\nL’unità esterna deve restare collegata durante il ripristino. Al termine, il volume esterno e i suoi dati verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を外部ボリュームからローカルにコピーし直してから、外部ボリューム「%@」を削除します。\n\n復元先：%@\n\n復元中は外部ストレージを接続したままにしてください。完了すると、外部ボリュームとそのデータは削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 외장 볼륨에서 이 Mac으로 복사한 후 외장 볼륨 “%@”을(를) 삭제합니다.\n\n복원 위치: %@\n\n복원하는 동안 외장 저장 장치를 연결해 두세요. 완료되면 외장 볼륨과 해당 데이터가 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer ‘%@’ van het externe volume terug naar deze Mac en verwijder daarna het externe volume ‘%@’.\n\nHerstellen naar: %@\n\nDe externe opslag moet tijdens het herstel aangesloten blijven. Na afloop worden het externe volume en de gegevens erop verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj „%@” z woluminu zewnętrznego z powrotem na Maca, a następnie usuń wolumin zewnętrzny „%@”.\n\nPrzywróć do: %@\n\nNośnik zewnętrzny musi pozostać podłączony podczas przywracania. Po zakończeniu wolumin zewnętrzny i znajdujące się na nim dane zostaną usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar “%@” do volume externo de volta para o Mac e depois apagar o volume externo “%@”.\n\nRestaurar em: %@\n\nO armazenamento externo precisa permanecer conectado durante a restauração. Ao terminar, o volume externo e seus dados serão apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопировать «%@» с внешнего тома обратно на Mac, затем удалить внешний том «%@».\n\nВосстановить в: %@\n\nВнешний накопитель должен оставаться подключённым во время восстановления. По завершении внешний том и данные на нём будут удалены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คัดลอก “%@” จากดิสก์โวลุ่มภายนอกกลับมายัง Mac เครื่องนี้ แล้วลบดิสก์โวลุ่มภายนอก “%@”\n\nกู้คืนไปที่: %@\n\nต้องเชื่อมต่ออุปกรณ์จัดเก็บข้อมูลภายนอกไว้ตลอดการกู้คืน เมื่อเสร็จแล้ว ดิสก์โวลุ่มภายนอกและข้อมูลในนั้นจะถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” öğesini harici birimden bu Mac’e geri kopyalayın, ardından “%@” adlı harici birimi silin.\n\nGeri yüklenecek konum: %@\n\nGeri yükleme sırasında harici depolama bağlı kalmalıdır. İşlem bitince harici birim ve içindeki veriler silinir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép “%@” từ ổ lưu trữ ngoài về máy Mac này, rồi xóa ổ lưu trữ ngoài “%@”.\n\nKhôi phục vào: %@\n\nPhải giữ bộ nhớ ngoài được kết nối trong khi khôi phục. Ổ lưu trữ ngoài và dữ liệu trên đó sẽ bị xóa khi hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将「%@」从外置卷复制回本地，然后删除外置卷「%@」。\n\n还原到：%@\n\n还原需要外部存储保持连接，完成后外置卷及其数据会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將「%@」從外接卷宗複製回本機，然後刪除外接卷宗「%@」。\n\n還原到：%@\n\n還原期間外接儲存裝置需保持連接，完成後外接卷宗及其資料將被刪除。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将「%@」苁外寘卷复制回本地，嘫后删除外寘卷「%@」。\n\n还原到：%@\n\n还原需要外部存储保持連接，完成后外寘卷及其数据会被删除。"
          }
        }
      }
    },
    "将「%@」从外部存储还原到本地" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعادة «%@» من التخزين الخارجي إلى المحلي"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠗⠑⠎⠞⠕⠗⠑ \"%@\" ⠋⠗⠕⠍ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑ ⠞⠕ ⠇⠕⠉⠁⠇"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ aus dem externen Speicher lokal wiederherstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore \"%@\" from external storage to local"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarigi «%@» el ekstera konservilo al loka"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar «%@» del almacenamiento externo al local"
          }
        },
        "fr" : {
