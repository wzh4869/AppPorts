        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar el acceso de este AppPorts: los archivos de prueba no están disponibles o se produjo otro error de lectura. Revise Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
