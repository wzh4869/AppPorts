    "等待解锁：请解锁数据卷后重试。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار إلغاء القفل: ألغِ قفل وحدة تخزين البيانات ثم أعد المحاولة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠺⠁⠊⠞⠊⠝⠛ ⠋⠕⠗ ⠥⠝⠇⠕⠉⠅⠒ ⠥⠝⠇⠕⠉⠅ ⠞⠓⠑ ⠙⠁⠞⠁ ⠧⠕⠇⠥⠍⠑⠂ ⠞⠓⠑⠝ ⠞⠗⠽ ⠁⠛⠁⠊⠝⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten auf Entsperren: Entsperre das Datenvolume und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for unlock: unlock the data volume, then try again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atendante malŝloson: malŝlosu la datumvolumon kaj reprovu."
