        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beibehaltenen Elemente befinden sich weiterhin an den aufgeführten Speicherorten. Du kannst sie im Finder verwalten oder nur diesen Eintrag entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The preserved materials are still at the listed locations. You can manage them in Finder or remove only this record."
