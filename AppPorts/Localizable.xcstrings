        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama açılış sorunlarını önlemek için macOS 27 ve sonrasında oturum açılışında otomatik yeniden imzalama kullanılamaz. İmza onarım adımlarını AppPorts içinde görüntüleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 trở lên không hỗ trợ tự động ký lại khi đăng nhập để tránh lỗi mở ứng dụng. Hãy xem các bước khôi phục chữ ký trong AppPorts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 及以上不支持开机自动重签名，以免影响应用启动。请在应用内查看签名修复步骤。"
          }
