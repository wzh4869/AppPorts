    "该目录位于沙盒容器内，macOS 会校验容器完整性。迁移会导致应用启动崩溃。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hada aldaleel fi dakhil hafizat alrimal. yatahadat macOS min salamat alhafizat. sayajalt alttahil alttatbiq eind albash."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠊⠎ ⠙⠊⠗⠑⠉⠞⠕⠗⠽ ⠊⠎ ⠊⠝⠎⠊⠙⠑ ⠁ ⠎⠁⠝⠙⠃⠕⠭ ⠉⠕⠝⠞⠁⠊⠝⠑⠗⠲ ⠍⠁⠉⠠⠕⠠⠎ ⠧⠁⠇⠊⠙⠁⠞⠑⠎ ⠉⠕⠝⠞⠁⠊⠝⠑⠗ ⠊⠝⠞⠑⠛⠗⠊⠞⠽⠲ ⠠⠍⠊⠛⠗⠁⠞⠊⠕⠝ ⠺⠊⠇⠇ ⠉⠁⠥⠎⠑ ⠞⠓⠑ ⠁⠏⠏ ⠞⠕ ⠉⠗⠁⠎⠓ ⠕⠝ ⠇⠁⠥⠝⠉⠓⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Verzeichnis befindet sich in einem Sandbox-Container. macOS ueberprueft die Container-Integritaet. Eine Migration fuehrte zum Absturz der App beim Start."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This directory is inside a sandbox container. macOS validates container integrity. Migration will cause the app to crash on launch."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi tiu direktoro troviighas ene de sabloksa ujo. macOS validas la integritecon de la ujo. Migrado kauxus kracon de la aplikacio dum lancho."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este directorio esta dentro de un contenedor sandbox. macOS verifica la integridad del contenedor. La migracion haria que la app se cierre inesperadamente al iniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce repertoire se trouve dans un conteneur sandbox. macOS verifie l'integrite du conteneur. La migration provoquerait un plantage de l'application au demarrage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yah drectory sandbox container ke andar hai. macOS container ki ekta ki jaanch karta hai. maigreshan se app shuru hone par kraash ho jaayega."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktori ini berada di dalam wadah sandbox. macOS memvalidasi integritas wadah. Migrasi akan menyebabkan aplikasi mogok saat diluncurkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa directory si trova all'interno di un contenitore sandbox. macOS verifica l'integrita del contenitore. La migrazione causerebbe il crash dell'app all'avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This directory is inside a sandbox container. macOS validates container integrity. Migration will cause the app to crash on launch."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디렉토리는 샌드박스 컨테이너 내부에 있습니다. macOS는 컨테이너 무결성을 검증합니다. 마이그레이션하면 앱이 시작 시 충돌합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze map bevindt zich in een sandbox-container. macOS verifieert de integriteit van de container. Migratie veroorzaakt een crash van de app bij het opstarten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten katalog znajduje sie w kontenerze sandbox. macOS weryfikuje integralnosc kontenera. Migracja spowoduje awarie aplikacji przy uruchomieniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este diretorio esta dentro de um contêiner sandbox. macOS valida a integridade do contêiner. A migracao faria o app travar ao iniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etot katalog nakhoditsya vnutri konteynera pesochnitsy. macOS proveryayet tselostnost konteynera. Migratsiya privedyot k sboyu prilozheniya pri zapuske."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drectory ni yu nai sandbox container. macOS ja truatsob khwam sombat khong container. kan yai ja thang hai app lom khi lot"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dizin bir sandbox konteynerinin icinde. macOS konteyner butunlugunu dogrular. Tasima uygulamanin baslatilmasinda cokmesine neden olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thu muc nay nam trong sandbox container. macOS xac minh tinh toan ven cua container. Di chuyen se khiem ung dung crash khi khoi dong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该目录位于沙盒容器内，macOS 会校验容器完整性。迁移会导致应用启动崩溃。"
