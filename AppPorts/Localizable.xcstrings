    "本地套件入口包含个人文件或其他真实内容，请先将其移到其他位置后再还原。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي اختصار مجموعة التطبيقات المحلي على ملفات شخصية أو محتوى فعلي آخر. انقلها إلى مكان آخر قبل الاستعادة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠇⠕⠉⠁⠇ ⠎⠥⠊⠞⠑ ⠎⠓⠕⠗⠞⠉⠥⠞ ⠉⠕⠝⠞⠁⠊⠝⠎ ⠏⠑⠗⠎⠕⠝⠁⠇ ⠋⠊⠇⠑⠎ ⠕⠗ ⠕⠞⠓⠑⠗ ⠗⠑⠁⠇ ⠉⠕⠝⠞⠑⠝⠞⠲ ⠠⠍⠕⠧⠑ ⠊⠞ ⠑⠇⠎⠑⠺⠓⠑⠗⠑ ⠃⠑⠋⠕⠗⠑ ⠗⠑⠎⠞⠕⠗⠊⠝⠛⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die lokale Paketverknüpfung enthält persönliche Dateien oder andere echte Inhalte. Verschieben Sie diese vor der Wiederherstellung an einen anderen Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local suite shortcut contains personal files or other real content. Move it elsewhere before restoring."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La loka ŝparvojo al la aplikaĵaro enhavas personajn dosierojn aŭ alian realan enhavon. Movu ilin aliloken antaŭ restaŭro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso directo local del conjunto contiene archivos personales u otro contenido real. Muévalos a otra ubicación antes de restaurar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci local de la suite contient des fichiers personnels ou d’autres contenus réels. Déplacez-les ailleurs avant de restaurer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थानीय ऐप समूह के शॉर्टकट में निजी फ़ाइलें या अन्य वास्तविक सामग्री है। बहाल करने से पहले उसे दूसरी जगह ले जाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan paket aplikasi lokal berisi berkas pribadi atau konten nyata lainnya. Pindahkan ke tempat lain sebelum memulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il collegamento locale della suite contiene file personali o altri contenuti reali. Spostali altrove prima del ripristino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルのアプリセットのショートカットに個人ファイルなどの実データがあります。別の場所に移してから復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 앱 모음 바로 가기에 개인 파일이나 다른 실제 콘텐츠가 있습니다. 다른 곳으로 옮긴 후 복원하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lokale snelkoppeling naar het pakket bevat persoonlijke bestanden of andere echte inhoud. Verplaats die eerst ergens anders voordat u herstelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalny skrót pakietu zawiera pliki osobiste lub inną rzeczywistą zawartość. Przed przywróceniem przenieś je w inne miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho local do conjunto contém arquivos pessoais ou outros conteúdos reais. Mova-os para outro local antes de restaurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальный ярлык набора содержит личные файлы или другие реальные данные. Переместите их в другое место перед восстановлением."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทางลัดชุดแอปในเครื่องมีไฟล์ส่วนตัวหรือเนื้อหาจริงอื่น โปรดย้ายไปที่อื่นก่อนกู้คืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel uygulama paketi kısayolunda kişisel dosyalar veya başka gerçek içerikler var. Geri yüklemeden önce bunları başka bir yere taşıyın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lối tắt bộ ứng dụng trên máy chứa tệp cá nhân hoặc nội dung thực khác. Hãy chuyển chúng sang nơi khác trước khi khôi phục."
          }
        },
        "zh-Hans" : {
