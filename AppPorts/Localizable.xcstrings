    "签名准备已取消，原应用未替换。AppPorts 会自动清理本次暂存数据。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُلغي تحضير التوقيع ولم يُستبدل التطبيق الأصلي. سيزيل AppPorts البيانات المؤقتة تلقائياً."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠎⠊⠛⠝⠊⠝⠛ ⠏⠗⠑⠏⠁⠗⠁⠞⠊⠕⠝ ⠺⠁⠎ ⠉⠁⠝⠉⠑⠇⠇⠑⠙ ⠁⠝⠙ ⠞⠓⠑ ⠕⠗⠊⠛⠊⠝⠁⠇ ⠁⠏⠏ ⠺⠁⠎ ⠝⠕⠞ ⠗⠑⠏⠇⠁⠉⠑⠙⠲ ⠠⠁⠏⠏⠠⠏⠕⠗⠞⠎ ⠺⠊⠇⠇ ⠁⠥⠞⠕⠍⠁⠞⠊⠉⠁⠇⠇⠽ ⠗⠑⠍⠕⠧⠑ ⠞⠓⠑ ⠞⠑⠍⠏⠕⠗⠁⠗⠽ ⠙⠁⠞⠁⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Signaturvorbereitung wurde abgebrochen; die ursprüngliche App wurde nicht ersetzt. AppPorts entfernt die temporären Daten automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing preparation was cancelled and the original app was not replaced. AppPorts will automatically remove the temporary data."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La subskriba preparo estis nuligita kaj la origina aplikaĵo ne estis anstataŭigita. AppPorts aŭtomate forigos la provizorajn datumojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló la preparación de firma y no se reemplazó la aplicación original. AppPorts eliminará automáticamente los datos temporales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La préparation de signature a été annulée et l’application d’origine n’a pas été remplacée. AppPorts supprimera automatiquement les données temporaires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हस्ताक्षर की तैयारी रद्द की गई और मूल ऐप नहीं बदला गया। AppPorts अस्थायी डेटा अपने आप हटा देगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
