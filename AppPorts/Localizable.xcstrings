        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung hat noch keine Kopie erstellt. Prüfen Sie den ursprünglichen Eintrag und die externen Daten und entsperren Sie den Vorgang, um die Wiederherstellung erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
