        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠥⠞⠕⠍⠁⠞⠊⠉ ⠍⠕⠥⠝⠞⠊⠝⠛ ⠊⠎ ⠏⠁⠥⠎⠑⠙ ⠋⠕⠗ ⠞⠓⠊⠎ ⠙⠊⠎⠅⠲ ⠠⠗⠑⠉⠕⠝⠝⠑⠉⠞ ⠞⠓⠑ ⠙⠑⠧⠊⠉⠑ ⠞⠕ ⠗⠑⠎⠥⠍⠑ ⠁⠥⠞⠕⠍⠁⠞⠊⠉ ⠍⠕⠥⠝⠞⠊⠝⠛⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das automatische Einhängen dieses Datenträgers ist pausiert. Schließen Sie das Gerät erneut an, um es fortzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic mounting is paused for this disk. Reconnect the device to resume automatic mounting."
