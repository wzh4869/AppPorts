          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền bị từ chối. Vui lòng cho phép Truy cập toàn bộ đĩa trong Cài đặt hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "权限不足。请前往“系统设置 > 隐私与安全性 > 完全磁盘访问权限”，允许 AppPorts 访问磁盘，然后重启应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權限不足。請前往「系統設定 > 隱私權與安全性 > 完全磁碟存取權」，允許 AppPorts 存取磁碟，然後重新啟動應用程式。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權限⑧足。請湔往“繫統設寘 > 隱私与安洤性 > 琓洤瓷盤訪問權限”，允許 AppPorts 訪問瓷盤，嘫後重啟應詠。"
          }
        }
      }
    },
    "权限修复失败，无法重签名。请手动执行: sudo chown -R $(whoami) \\" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل إصلاح الأذونات، ولا يمكن إعادة التوقيع. نفّذ يدويًا: sudo chown -R $(whoami) \\"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠏⠑⠗⠍⠊⠎⠎⠊⠕⠝ ⠗⠑⠏⠁⠊⠗ ⠋⠁⠊⠇⠑⠙⠆ ⠉⠁⠝⠝⠕⠞ ⠗⠑⠤⠎⠊⠛⠝⠲ ⠠⠗⠥⠝ ⠍⠁⠝⠥⠁⠇⠇⠽⠒ ⠎⠥⠙⠕ ⠉⠓⠕⠺⠝ ⠤⠠⠗ $⠐⠣⠺⠓⠕⠁⠍⠊⠐⠜ \\"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungsreparatur fehlgeschlagen; erneutes Signieren nicht möglich. Bitte manuell ausführen: sudo chown -R $(whoami) \\"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission repair failed; cannot re-sign. Run manually: sudo chown -R $(whoami) \\"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajtoplumigo malsukcesis, resubskribo ne eblas. Rulu permane: sudo chown -R $(whoami) \\"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron reparar los permisos; no se puede volver a firmar. Ejecuta manualmente: sudo chown -R $(whoami) \\"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la réparation des autorisations ; re-signature impossible. Exécutez manuellement : sudo chown -R $(whoami) \\"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमतियाँ ठीक करने में विफल; पुनः हस्ताक्षर नहीं किया जा सकता। कृपया मैन्युअल रूप से चलाएँ: sudo chown -R $(whoami) \\"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbaikan izin gagal, tidak dapat menandatangani ulang. Jalankan secara manual: sudo chown -R $(whoami) \\"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riparazione dei permessi non riuscita; impossibile rifirmare. Esegui manualmente: sudo chown -R $(whoami) \\"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限の修復に失敗したため、再署名できません。手動で実行してください: sudo chown -R $(whoami) \\"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한 복구에 실패하여 재서명할 수 없습니다. 직접 실행하십시오: sudo chown -R $(whoami) \\"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstellen van rechten mislukt; opnieuw ondertekenen niet mogelijk. Voer handmatig uit: sudo chown -R $(whoami) \\"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się naprawić uprawnień, ponowne podpisanie niemożliwe. Uruchom ręcznie: sudo chown -R $(whoami) \\"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha na reparação das permissões; não é possível reassinar. Execute manualmente: sudo chown -R $(whoami) \\"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось восстановить права, переподпись невозможна. Выполните вручную: sudo chown -R $(whoami) \\"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อมแซมสิทธิ์ไม่สำเร็จ จึงลงชื่อใหม่ไม่ได้ กรุณารันด้วยตนเอง: sudo chown -R $(whoami) \\"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin onarımı başarısız; yeniden imzalanamıyor. Lütfen elle çalıştırın: sudo chown -R $(whoami) \\"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sửa quyền thất bại, không thể ký lại. Vui lòng chạy thủ công: sudo chown -R $(whoami) \\"
          }
        },
        "zh-Hans" : {
