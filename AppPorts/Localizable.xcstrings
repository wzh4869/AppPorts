          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित अपडेट पूरा नहीं हुआ। पिछले संस्करण का बैकअप सुरक्षित है। AppPorts फिर खोलें या रिलीज़ पेज से मैन्युअल अपडेट करें।"
