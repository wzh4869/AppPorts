          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiński pakiet aktualizacji jest niedostępny. Spróbuj ponownie lub pobierz go ręcznie z chińskiej strony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pacote de atualização da China está indisponível. Tente novamente ou baixe manualmente pelo site chinês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет обновления в Китае недоступен. Повторите попытку или скачайте его вручную с китайского сайта."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แพ็กเกจอัปเดตในจีนไม่พร้อมใช้งาน โปรดลองอีกครั้งหรือดาวน์โหลดด้วยตนเองจากเว็บไซต์ดาวน์โหลดในจีน"
