          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい場所のアプリが元の署名検証に合格するか確認しています。大きなアプリでは時間がかかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
