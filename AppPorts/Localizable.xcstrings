          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można obecnie zweryfikować wcześniejszego oryginału; jego lokalizacja może być odłączona lub zmieniona. Możesz wybrać oficjalny oryginał lub usunąć tylko zapis."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
