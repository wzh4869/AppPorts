        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen des früheren signierten Originals wurde genehmigt. Die Bereinigung ist unvollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
