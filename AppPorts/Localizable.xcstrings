    "应用位置已切换，完成记录待写入。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تبديل موقع التطبيق. ما زال سجل الإكمال بحاجة إلى الحفظ."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠁⠏⠏ ⠇⠕⠉⠁⠞⠊⠕⠝ ⠓⠁⠎ ⠎⠺⠊⠞⠉⠓⠑⠙⠲ ⠠⠞⠓⠑ ⠉⠕⠍⠏⠇⠑⠞⠊⠕⠝ ⠗⠑⠉⠕⠗⠙ ⠎⠞⠊⠇⠇ ⠝⠑⠑⠙⠎ ⠞⠕ ⠃⠑ ⠎⠁⠧⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App-Speicherort wurde umgestellt. Der Abschluss muss noch gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app location has switched. The completion record still needs to be saved."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplikaĵa loko estas ŝanĝita. La finregistro ankoraŭ devas esti konservita."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación de la app ha cambiado. Falta guardar el registro de finalización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’emplacement de l’app a changé. L’enregistrement de fin reste à sauvegarder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का स्थान बदल गया है। पूर्ण होने का रिकॉर्ड अभी सहेजना बाकी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi aplikasi telah beralih. Catatan penyelesaian masih perlu disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione dell’app è cambiata. Il registro di completamento deve ancora essere salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの場所は切り替わりました。完了記録の保存が残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 위치가 전환되었습니다. 완료 기록을 저장해야 합니다."
          }
        },
        "nl" : {
