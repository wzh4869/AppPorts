        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外寘盤未連接。連接这塊外部存储后会自动接回；如果已经連接仍顯示此狀態，数据卷可能被改名或删除，请查看挂载迁移文档裏的排查步骤"
          }
        }
