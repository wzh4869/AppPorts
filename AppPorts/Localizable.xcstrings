        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠎⠁⠝⠙⠃⠕⠭⠑⠙ ⠁⠏⠏⠒ ⠉⠕⠝⠞⠁⠊⠝⠑⠗ ⠙⠁⠞⠁ ⠉⠁⠝ ⠕⠝⠇⠽ ⠗⠑⠁⠉⠓ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑ ⠞⠓⠗⠕⠥⠛⠓ ⠍⠕⠥⠝⠞ ⠍⠊⠛⠗⠁⠞⠊⠕⠝⠆ ⠎⠽⠍⠃⠕⠇⠊⠉ ⠇⠊⠝⠅⠎ ⠁⠗⠑ ⠗⠑⠚⠑⠉⠞⠑⠙ ⠃⠽ ⠞⠓⠑ ⠎⠽⠎⠞⠑⠍"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox-App: Containerdaten können nur per Mount-Migration auf externen Speicher verschoben werden. Symbolische Links werden vom System abgewiesen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandboxed app: container data can only reach external storage through mount migration; symbolic links are rejected by the system"
