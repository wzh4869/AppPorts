    "签名操作锁正被占用，本次未执行。请稍后重试；若持续出现，请导出诊断包。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قفل عمليات التوقيع قيد الاستخدام. لم يُنفذ هذا الإجراء. حاول لاحقًا، وإذا استمرت المشكلة فصدّر حزمة تشخيص."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠎⠊⠛⠝⠊⠝⠛ ⠕⠏⠑⠗⠁⠞⠊⠕⠝ ⠇⠕⠉⠅ ⠊⠎ ⠊⠝ ⠥⠎⠑⠲ ⠠⠞⠓⠊⠎ ⠁⠉⠞⠊⠕⠝ ⠺⠁⠎ ⠝⠕⠞ ⠏⠑⠗⠋⠕⠗⠍⠑⠙⠲ ⠠⠞⠗⠽ ⠁⠛⠁⠊⠝ ⠇⠁⠞⠑⠗⠆ ⠊⠋ ⠞⠓⠑ ⠊⠎⠎⠥⠑ ⠏⠑⠗⠎⠊⠎⠞⠎⠂ ⠑⠭⠏⠕⠗⠞ ⠁ ⠙⠊⠁⠛⠝⠕⠎⠞⠊⠉ ⠏⠁⠉⠅⠁⠛⠑⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sperre für Signierungsvorgänge ist belegt. Diese Aktion wurde nicht ausgeführt. Versuche es später erneut. Exportiere bei anhaltenden Problemen ein Diagnosepaket."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The signing operation lock is in use. This action was not performed. Try again later; if the issue persists, export a diagnostic package."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seruro por subskribaj operacioj estas uzata. Ĉi tiu ago ne estis farita. Reprovu poste; se la problemo daŭras, eksportu diagnozan pakaĵon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo de operaciones de firma está en uso. Esta acción no se ha realizado. Inténtalo más tarde; si el problema persiste, exporta un paquete de diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrou des opérations de signature est occupé. Cette action n’a pas été effectuée. Réessayez plus tard ; si le problème persiste, exportez un paquet de diagnostic."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हस्ताक्षर कार्रवाई का लॉक उपयोग में है। यह कार्रवाई नहीं की गई। बाद में दोबारा प्रयास करें; समस्या बनी रहे तो निदान पैकेज निर्यात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci operasi penandatanganan sedang digunakan. Tindakan ini tidak dilakukan. Coba lagi nanti; jika masalah berlanjut, ekspor paket diagnostik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco delle operazioni di firma è in uso. Questa azione non è stata eseguita. Riprova più tardi; se il problema persiste, esporta un pacchetto diagnostico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名操作ロックが使用中のため、この操作は実行されませんでした。時間をおいて再試行し、問題が続く場合は診断パッケージをエクスポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명 작업 잠금이 사용 중이므로 이 작업은 실행되지 않았습니다. 나중에 다시 시도하고, 문제가 계속되면 진단 패키지를 내보내세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vergrendeling voor ondertekening is bezet. Deze actie is niet uitgevoerd. Probeer het later opnieuw; exporteer een diagnosepakket als het probleem aanhoudt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokada operacji podpisywania jest zajęta. Ta czynność nie została wykonana. Spróbuj później; jeśli problem się powtarza, wyeksportuj pakiet diagnostyczny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio de operações de assinatura está em uso. Esta ação não foi executada. Tente novamente mais tarde; se o problema persistir, exporte um pacote de diagnóstico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка операций подписи занята. Это действие не выполнено. Повторите попытку позже; если проблема сохраняется, экспортируйте диагностический пакет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล็อกการลงนามกำลังถูกใช้งาน ยังไม่ได้ดำเนินการนี้ โปรดลองอีกครั้งภายหลัง หากยังเกิดปัญหา ให้ส่งออกแพ็กเกจการวินิจฉัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmzalama işlemi kilidi kullanımda. Bu işlem gerçekleştirilmedi. Daha sonra yeniden deneyin; sorun sürerse bir tanılama paketi dışa aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa thao tác ký đang được sử dụng. Thao tác này chưa được thực hiện. Hãy thử lại sau; nếu vấn đề tiếp diễn, hãy xuất gói chẩn đoán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签名操作锁正被占用，本次未执行。请稍后重试；若持续出现，请导出诊断包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名操作鎖正被佔用，本次未執行。請稍後重試；若持續出現，請匯出診斷套件。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名操作鎖正被佔用，夲佽未執荇。請稍後重試；若持續出現，請導出診斷包。"
          }
        }
      }
    },
    "签名材料缺失、身份改变或校验失败，已保留现有应用和可用材料。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواد التوقيع مفقودة، أو تغيّرت هويتها، أو فشل التحقق منها. تم الاحتفاظ بالتطبيق الحالي والمواد المتاحة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠎⠊⠛⠝⠁⠞⠥⠗⠑ ⠍⠁⠞⠑⠗⠊⠁⠇ ⠊⠎ ⠍⠊⠎⠎⠊⠝⠛⠂ ⠊⠞⠎ ⠊⠙⠑⠝⠞⠊⠞⠽ ⠉⠓⠁⠝⠛⠑⠙⠂ ⠕⠗ ⠧⠑⠗⠊⠋⠊⠉⠁⠞⠊⠕⠝ ⠋⠁⠊⠇⠑⠙⠲ ⠠⠞⠓⠑ ⠉⠥⠗⠗⠑⠝⠞ ⠁⠏⠏ ⠁⠝⠙ ⠁⠧⠁⠊⠇⠁⠃⠇⠑ ⠍⠁⠞⠑⠗⠊⠁⠇ ⠓⠁⠧⠑ ⠃⠑⠑⠝ ⠏⠗⠑⠎⠑⠗⠧⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaturmaterial fehlt, seine Identität hat sich geändert oder die Prüfung ist fehlgeschlagen. Die aktuelle App und das verfügbare Material wurden beibehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signature material is missing, its identity changed, or verification failed. The current app and available material have been preserved."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskriba materialo mankas, ĝia identeco ŝanĝiĝis aŭ kontrolo malsukcesis. La nuna aplikaĵo kaj la disponebla materialo estis konservitaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta material de firma, su identidad cambió o falló la verificación. Se han conservado la aplicación actual y el material disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments de signature sont absents, leur identité a changé ou leur vérification a échoué. L’application actuelle et les éléments disponibles ont été conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हस्ताक्षर सामग्री गायब है, उसकी पहचान बदल गई है या सत्यापन विफल हुआ है। मौजूदा ऐप और उपलब्ध सामग्री सुरक्षित रखी गई है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Materi tanda tangan hilang, identitasnya berubah, atau verifikasi gagal. Aplikasi saat ini dan materi yang tersedia telah dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il materiale della firma manca, la sua identità è cambiata o la verifica non è riuscita. L’app attuale e il materiale disponibile sono stati conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名用の素材が見つからない、識別情報が変わった、または検証に失敗しました。現在のアプリと利用可能な素材は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명 자료가 없거나 식별 정보가 변경되었거나 검증에 실패했습니다. 현재 앱과 사용 가능한 자료는 보존되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handtekeningmateriaal ontbreekt, de identiteit ervan is veranderd of de controle is mislukt. De huidige app en het beschikbare materiaal zijn behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje materiału podpisu, zmieniła się jego tożsamość lub weryfikacja nie powiodła się. Zachowano obecną aplikację i dostępne materiały."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O material de assinatura está ausente, sua identidade mudou ou a verificação falhou. O aplicativo atual e o material disponível foram preservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Материалы подписи отсутствуют, их идентичность изменилась или проверка не пройдена. Текущее приложение и доступные материалы сохранены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลลายเซ็นหายไป ข้อมูลประจำตัวเปลี่ยนแปลง หรือการตรวจสอบไม่สำเร็จ แอปปัจจุบันและข้อมูลที่ยังใช้ได้ถูกเก็บไว้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmza malzemesi eksik, kimliği değişmiş veya doğrulama başarısız olmuş. Mevcut uygulama ve kullanılabilir malzeme korundu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tư liệu chữ ký bị thiếu, danh tính đã thay đổi hoặc xác minh thất bại. Ứng dụng hiện tại và tư liệu còn dùng được đã được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签名材料缺失、身份改变或校验失败，已保留现有应用和可用材料。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名材料遺失、身分改變或驗證失敗，已保留現有應用程式與可用材料。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽銘材料遺失、身份改變或驗證失贁，已保留現有應苚程鉽與可用材料。"
          }
        }
      }
    },
    "签名检查通过后，请先从 Finder 或 Dock 打开应用并确认数据正常，再到「应用数据」页迁移。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد نجاح فحص التوقيع، افتح التطبيق من Finder أو Dock وتحقق من بياناته قبل النقل في «بيانات التطبيقات»."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠁⠋⠞⠑⠗ ⠞⠓⠑ ⠎⠊⠛⠝⠁⠞⠥⠗⠑ ⠉⠓⠑⠉⠅ ⠏⠁⠎⠎⠑⠎, ⠕⠏⠑⠝ ⠞⠓⠑ ⠁⠏⠏ ⠋⠗⠕⠍ ⠋⠊⠝⠙⠑⠗ ⠕⠗ ⠞⠓⠑ ⠙⠕⠉⠅ ⠁⠝⠙ ⠉⠕⠝⠋⠊⠗⠍ ⠊⠞⠎ ⠙⠁⠞⠁ ⠊⠎ ⠁⠉⠉⠑⠎⠎⠊⠃⠇⠑ ⠃⠑⠋⠕⠗⠑ ⠍⠊⠛⠗⠁⠞⠊⠝⠛ ⠊⠝ ⠁⠏⠏ ⠙⠁⠞⠁."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die App nach erfolgreicher Signaturprüfung über Finder oder Dock und prüfe ihre Daten, bevor du unter „App-Daten“ migrierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the signature check passes, open the app from Finder or the Dock and confirm its data is accessible before migrating in App Data."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post sukcesa subskriba kontrolo, malfermu la aplikaĵon per Finder aŭ Dock kaj kontrolu ĝiajn datumojn antaŭ migrado en “Aplikaĵaj datumoj”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras comprobar la firma, abra la app desde Finder o el Dock y verifique sus datos antes de migrar en «Datos de apps»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après vérification de la signature, ouvrez l’app depuis Finder ou le Dock et vérifiez ses données avant de migrer dans « Données des apps »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हस्ताक्षर की जाँच सफल होने पर Finder या Dock से ऐप खोलें और डेटा जाँचें, फिर “ऐप डेटा” में स्थानांतरित करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah pemeriksaan tanda tangan berhasil, buka aplikasi dari Finder atau Dock dan periksa datanya sebelum migrasi di “Data Aplikasi”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo la verifica della firma, apri l’app dal Finder o dal Dock e controlla i dati prima di migrare in “Dati delle app”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名確認に成功したら Finder または Dock から開き、データが使えることを確認してから「アプリデータ」で移行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명 검사를 통과하면 Finder 또는 Dock에서 앱을 열어 데이터를 확인한 뒤 ‘앱 데이터’에서 마이그레이션하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de app na de handtekeningcontrole vanuit Finder of het Dock en controleer de gegevens voordat je in “Appgegevens” migreert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po sprawdzeniu podpisu otwórz aplikację z Findera lub Docka i sprawdź dane przed migracją w „Danych aplikacji”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após verificar a assinatura, abra o app pelo Finder ou Dock e confira seus dados antes de migrar em “Dados dos apps”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После проверки подписи откройте приложение из Finder или Dock и проверьте данные перед переносом в разделе «Данные приложений»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังตรวจสอบลายเซ็นผ่าน ให้เปิดแอปจาก Finder หรือ Dock และตรวจสอบข้อมูลก่อนย้ายในหน้า “ข้อมูลแอป”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmza denetimi başarılı olduktan sonra uygulamayı Finder veya Dock’tan açıp verileri doğrulayın, ardından “Uygulama Verileri” bölümünden taşıyın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi kiểm tra chữ ký thành công, mở ứng dụng từ Finder hoặc Dock và xác nhận dữ liệu trước khi di chuyển trong “Dữ liệu ứng dụng”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签名检查通过后，请先从 Finder 或 Dock 打开应用并确认数据正常，再到「应用数据」页迁移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名檢查通過後，請先從 Finder 或 Dock 開啟應用程式並確認資料正常，再到「應用程式資料」頁遷移。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名檢查通過後，請先从 Finder 或 Dock 打开應用并确认數據正常，再到「應用數據」页遷移。"
          }
        }
      }
    },
    "签名通过不代表应用能够启动，钥匙串或其他系统授权也可能改变。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نجاح التوقيع لا يضمن تشغيل التطبيق. قد يتغيّر أيضًا الوصول إلى سلسلة المفاتيح أو أذونات النظام الأخرى."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠎⠥⠉⠉⠑⠎⠎⠋⠥⠇ ⠎⠊⠛⠝⠊⠝⠛ ⠙⠕⠑⠎ ⠝⠕⠞ ⠛⠥⠁⠗⠁⠝⠞⠑⠑ ⠞⠓⠑ ⠁⠏⠏ ⠉⠁⠝ ⠇⠁⠥⠝⠉⠓⠲ ⠠⠅⠑⠽⠉⠓⠁⠊⠝ ⠁⠉⠉⠑⠎⠎ ⠕⠗ ⠕⠞⠓⠑⠗ ⠎⠽⠎⠞⠑⠍ ⠏⠑⠗⠍⠊⠎⠎⠊⠕⠝⠎ ⠍⠁⠽ ⠁⠇⠎⠕ ⠉⠓⠁⠝⠛⠑⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erfolgreiche Signierung garantiert keinen App-Start. Auch der Schlüsselbundzugriff und andere Systemberechtigungen können sich ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Successful signing does not guarantee the app can launch. Keychain access or other system permissions may also change."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukcesa subskribo ne garantias, ke la apo lanĉiĝos. Alirrajtoj al la ŝlosilĉeno aŭ aliaj sistemaj permesoj ankaŭ povas ŝanĝiĝi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una firma correcta no garantiza que la app arranque. También pueden cambiar el acceso al llavero u otros permisos del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une signature valide ne garantit pas le lancement de l’app. L’accès au trousseau et d’autres autorisations système peuvent aussi changer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफल हस्ताक्षर ऐप खुलने की गारंटी नहीं देते। कीचेन की पहुँच या अन्य सिस्टम अनुमतियाँ भी बदल सकती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penandatanganan yang berhasil tidak menjamin aplikasi dapat dibuka. Akses rantai kunci atau izin sistem lainnya juga dapat berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una firma riuscita non garantisce l’avvio dell’app. Potrebbero cambiare anche l’accesso al portachiavi o altri permessi di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名に成功しても、アプリの起動は保証されません。キーチェーンへのアクセスやその他のシステム権限も変わる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명에 성공해도 앱 실행이 보장되지는 않습니다. 키체인 접근 권한이나 다른 시스템 권한도 달라질 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een geslaagde ondertekening garandeert niet dat de app start. Ook sleutelhangerrechten en andere systeemrechten kunnen veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprawny podpis nie gwarantuje uruchomienia aplikacji. Mogą się też zmienić dostęp do pęku kluczy i inne uprawnienia systemowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma assinatura bem-sucedida não garante que a app inicie. O acesso ao Porta-chaves ou outras permissões do sistema também podem mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Успешная подпись не гарантирует запуск приложения. Доступ к Связке ключей и другие системные разрешения также могут измениться."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลงนามสำเร็จไม่ได้รับประกันว่าแอปจะเปิดได้ สิทธิ์เข้าถึงพวงกุญแจหรือสิทธิ์ระบบอื่นอาจเปลี่ยนด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başarılı imzalama uygulamanın açılacağını garanti etmez. Anahtar zinciri erişimi veya diğer sistem izinleri de değişebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký thành công không đảm bảo ứng dụng khởi chạy. Quyền truy cập chuỗi khóa hoặc các quyền hệ thống khác cũng có thể thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签名通过不代表应用能够启动，钥匙串或其他系统授权也可能改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名通過不代表應用能夠啓動，鑰匙串或其他系統授權也可能改變。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名通過⑧代表應詠能夠啓動，鑰匙串或其他系統授權也可能改變。"
          }
        }
      }
    },
