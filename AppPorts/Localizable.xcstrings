    "安全连接验证失败，请检查网络或代理。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل التحقق من الاتصال الآمن. تحقق من الشبكة أو الوكيل."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠎⠑⠉⠥⠗⠑ ⠉⠕⠝⠝⠑⠉⠞⠊⠕⠝ ⠧⠑⠗⠊⠋⠊⠉⠁⠞⠊⠕⠝ ⠋⠁⠊⠇⠑⠙⠲ ⠠⠉⠓⠑⠉⠅ ⠽⠕⠥⠗ ⠝⠑⠞⠺⠕⠗⠅ ⠕⠗ ⠏⠗⠕⠭⠽⠲"
