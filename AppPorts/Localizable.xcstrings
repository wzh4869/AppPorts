        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Externer Speicher ist nicht verbunden. Verbinden Sie ihn und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "External storage is not connected. Connect it and try again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstera konservejo ne estas konektita. Konektu ĝin kaj reprovu."
