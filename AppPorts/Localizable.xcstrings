    "请先为新数据卷设置加密密码，原数据尚未改动。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن أولًا كلمة مرور تشفير لوحدة تخزين البيانات الجديدة. لم يتم تغيير البيانات الأصلية."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠎⠑⠞ ⠁⠝ ⠑⠝⠉⠗⠽⠏⠞⠊⠕⠝ ⠏⠁⠎⠎⠺⠕⠗⠙ ⠋⠕⠗ ⠞⠓⠑ ⠝⠑⠺ ⠙⠁⠞⠁ ⠧⠕⠇⠥⠍⠑ ⠋⠊⠗⠎⠞⠲ ⠠⠞⠓⠑ ⠕⠗⠊⠛⠊⠝⠁⠇ ⠙⠁⠞⠁ ⠓⠁⠎⠝’⠞ ⠃⠑⠑⠝ ⠉⠓⠁⠝⠛⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege zuerst ein Verschlüsselungskennwort für das neue Datenvolume fest. Die Originaldaten wurden nicht verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set an encryption password for the new data volume first. The original data hasn’t been changed."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unue agordu ĉifran pasvorton por la nova datumvolumo. La originalaj datumoj ankoraŭ ne ŝanĝiĝis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero define una contraseña de cifrado para el nuevo volumen de datos. Los datos originales no se han modificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez d’abord un mot de passe de chiffrement pour le nouveau volume de données. Les données d’origine n’ont pas été modifiées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले नए डेटा वॉल्यूम के लिए एन्क्रिप्शन पासवर्ड सेट करें। मूल डेटा अभी तक नहीं बदला गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setel kata sandi enkripsi untuk volume data baru terlebih dahulu. Data asli belum diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta prima una password di crittografia per il nuovo volume dati. I dati originali non sono stati modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に新しいデータボリュームの暗号化パスワードを設定してください。元のデータはまだ変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
