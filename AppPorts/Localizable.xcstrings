    "检查目标端存储块大小失败：fstatfs 返回 f_bsize=%@，无法处理稀疏文件。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل فحص حجم كتلة التخزين في الوجهة: أعادت fstatfs القيمة f_bsize=%@؛ لا يمكن معالجة الملفات المتناثرة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠋⠁⠊⠇⠑⠙ ⠞⠕ ⠉⠓⠑⠉⠅ ⠞⠓⠑ ⠙⠑⠎⠞⠊⠝⠁⠞⠊⠕⠝ ⠎⠞⠕⠗⠁⠛⠑ ⠃⠇⠕⠉⠅ ⠎⠊⠵⠑⠒ ⠋⠎⠞⠁⠞⠋⠎ ⠗⠑⠞⠥⠗⠝⠑⠙ ⠋⠸⠤⠃⠎⠊⠵⠑=%@⠆ ⠎⠏⠁⠗⠎⠑ ⠋⠊⠇⠑⠎ ⠉⠁⠝⠝⠕⠞ ⠃⠑ ⠓⠁⠝⠙⠇⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Speicherblockgröße am Ziel konnte nicht geprüft werden: fstatfs hat f_bsize=%@ zurückgegeben; Sparse-Dateien können nicht verarbeitet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to check the destination storage block size: fstatfs returned f_bsize=%@; sparse files cannot be handled."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolo de la grandeco de konservaj blokoj ĉe la celo malsukcesis: fstatfs redonis f_bsize=%@; maldensaj dosieroj ne povas esti traktataj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo comprobar el tamaño de bloque de almacenamiento del destino: fstatfs devolvió f_bsize=%@; no se pueden procesar archivos dispersos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de contrôler la taille des blocs de stockage à destination : fstatfs a renvoyé f_bsize=%@ ; les fichiers creux ne peuvent pas être traités."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य के स्टोरेज ब्लॉक आकार की जाँच विफल हुई: fstatfs ने f_bsize=%@ लौटाया; स्पार्स फ़ाइलों को संभाला नहीं जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal memeriksa ukuran blok penyimpanan tujuan: fstatfs mengembalikan f_bsize=%@; berkas sparse tidak dapat ditangani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo della dimensione dei blocchi di archiviazione a destinazione non riuscito: fstatfs ha restituito f_bsize=%@; impossibile gestire i file sparsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー先のストレージブロックサイズの確認に失敗しました：fstatfs が f_bsize=%@ を返したため、スパースファイルを処理できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 측 저장 블록 크기 확인에 실패했습니다. fstatfs가 f_bsize=%@을(를) 반환하여 희소 파일을 처리할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de opslagblokgrootte op de bestemming niet controleren: fstatfs heeft f_bsize=%@ teruggegeven; ijle bestanden kunnen niet worden verwerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się sprawdzić rozmiaru bloku pamięci masowej w miejscu docelowym: fstatfs zwrócił f_bsize=%@; nie można obsługiwać plików rzadkich."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao verificar o tamanho do bloco de armazenamento do destino: fstatfs retornou f_bsize=%@; não é possível processar arquivos esparsos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить размер блока хранилища в месте назначения: fstatfs вернул f_bsize=%@; обработка разреженных файлов невозможна."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบขนาดบล็อกจัดเก็บข้อมูลที่ปลายทางไม่สำเร็จ: fstatfs ส่งคืน f_bsize=%@ จึงไม่สามารถจัดการไฟล์สปาร์สได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef depolama bloğu boyutu denetlenemedi: fstatfs, f_bsize=%@ değerini döndürdü; seyrek dosyalar işlenemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kiểm tra kích thước khối lưu trữ ở đích: fstatfs trả về f_bsize=%@; không thể xử lý tệp thưa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查目标端存储块大小失败：fstatfs 返回 f_bsize=%@，无法处理稀疏文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查目的端儲存區塊大小失敗：fstatfs 傳回 f_bsize=%@，無法處理稀疏檔案。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查目標端邨存塊大曉失敗：fstatfs 返囙 f_bsize=%@，無法處理稀疏攵件。"
          }
        }
      }
