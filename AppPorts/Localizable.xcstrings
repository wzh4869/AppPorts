          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sichere deine Daten vor jedem Eingriff und beachte, dass Time Machine standardmäßig nur das interne Laufwerk des Mac sichert – halte für wichtige Daten auf externen Laufwerken eine eigene Sicherung bereit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "back up your data before making changes, and note that Time Machine backs up your Mac’s internal drive by default—keep a separate backup of important data moved to an external drive"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fari sekurkopion antaŭ ŝanĝoj, kaj notu ke Time Machine defaŭlte sekurkopias nur la internan diskon de Mac — konservu apartan sekurkopion de gravaj datumoj movitaj al ekstera disko"
          }
        },
        "es" : {
