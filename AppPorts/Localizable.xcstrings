    "--deep 签名失败，回退到表层签名" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل التوقيع بـ --deep؛ الرجوع إلى التوقيع السطحي"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠤⠤⠙⠑⠑⠏ ⠎⠊⠛⠝⠊⠝⠛ ⠋⠁⠊⠇⠑⠙⠆ ⠋⠁⠇⠇⠊⠝⠛ ⠃⠁⠉⠅ ⠞⠕ ⠎⠓⠁⠇⠇⠕⠺ ⠎⠊⠛⠝⠊⠝⠛"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--deep-Signierung fehlgeschlagen; Rückfall auf oberflächliche Signierung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--deep signing failed; falling back to shallow signing"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskribo per --deep malsukcesis; reveno al supraĵa subskribo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallo la firma --deep; se pasa a la firma superficial"
