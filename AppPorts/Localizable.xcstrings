        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले की हस्ताक्षरित मूल प्रति हटाने की अनुमति दी गई है। सफ़ाई अधूरी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penghapusan salinan asli bertanda tangan sebelumnya telah diizinkan. Pembersihan belum selesai."
