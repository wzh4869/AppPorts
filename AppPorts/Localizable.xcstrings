        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preparita ŝparvojo ankoraŭ ne havas konservitan apartenregistron. Vi povas nuligi ĉi tiun provon kaj konservi la objekton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso directo temporal aún no tiene un registro de pertenencia guardado. Puede cancelar este intento y conservar el elemento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci temporaire n’a pas encore d’enregistrement d’appartenance sauvegardé. Vous pouvez annuler cette tentative et conserver l’élément."
