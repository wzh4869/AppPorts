        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskin çevrimdışı olup olmadığı doğrulanamadı. Otomatik bağlama hâlâ duraklatılmış durumda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác nhận đĩa đã ngoại tuyến hay chưa. Tự động gắn kết vẫn tạm dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认磁盘是否已离线，自动挂载仍已暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認磁碟是否已離線，自動掛載仍維持暫停。"
