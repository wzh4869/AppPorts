        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze map bevindt zich in een sandbox-container. macOS verifieert de integriteit van de container. Migratie veroorzaakt een crash van de app bij het opstarten."
          }
        },
        "pl" : {
