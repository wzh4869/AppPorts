        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operacio ne finiĝis. Ĝiaj ŝanĝoj estis nuligitaj kaj la originaj datumoj estis konservitaj. Vi povas reprovi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operación no se completó. Sus cambios se revirtieron y se conservaron los datos originales. Puedes volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'opération n'a pas abouti. Ses modifications ont été annulées et les données d'origine ont été préservées. Vous pouvez réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑपरेशन पूरा नहीं हुआ। इसके परिवर्तन वापस ले लिए गए और मूल डेटा संरक्षित रखा गया। आप पुनः प्रयास कर सकते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
