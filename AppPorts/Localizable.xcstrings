    "读不到外部存储路径：%@。请连接外部存储后重新检查。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت قراءة مسار التخزين الخارجي: %@. وصّل التخزين الخارجي وأعد الفحص."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠉⠁⠝⠝⠕⠞ ⠗⠑⠁⠙ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑ ⠏⠁⠞⠓⠒ %@⠲ ⠠⠉⠕⠝⠝⠑⠉⠞ ⠞⠓⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑ ⠁⠝⠙ ⠉⠓⠑⠉⠅ ⠁⠛⠁⠊⠝⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Pfad des externen Speichers kann nicht gelesen werden: %@. Verbinde den externen Speicher und prüfe erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot read the external storage path: %@. Connect the external storage and check again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne eblas legi la vojon de la ekstera konservilo: %@. Konektu la eksteran konservilon kaj rekontrolu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer la ruta del almacenamiento externo: %@. Conecta el almacenamiento externo y vuelve a comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le chemin du stockage externe : %@. Connectez le stockage externe, puis vérifiez à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहरी स्टोरेज का पथ पढ़ा नहीं जा सका: %@। बाहरी स्टोरेज जोड़ें और फिर से जाँचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat membaca jalur penyimpanan eksternal: %@. Hubungkan penyimpanan eksternal lalu periksa lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il percorso dell’unità esterna: %@. Collega l’unità esterna e ripeti la verifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部ストレージのパスを読み取れません：%@。外部ストレージを接続してから再チェックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외장 저장 장치 경로를 읽을 수 없습니다: %@. 외장 저장 장치를 연결한 후 다시 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het pad naar de externe opslag kan niet worden gelezen: %@. Sluit de externe opslag aan en controleer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać ścieżki nośnika zewnętrznego: %@. Podłącz nośnik zewnętrzny i sprawdź ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler o caminho do armazenamento externo: %@. Conecte o armazenamento externo e verifique novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся прочитать путь внешнего накопителя: %@. Подключите накопитель и повторите проверку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านเส้นทางอุปกรณ์จัดเก็บข้อมูลภายนอกไม่ได้: %@ โปรดเชื่อมต่ออุปกรณ์แล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici depolama yolu okunamıyor: %@. Harici depolamayı bağlayıp yeniden kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc đường dẫn bộ nhớ ngoài: %@. Hãy kết nối bộ nhớ ngoài rồi kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读不到外部存储路径：%@。请连接外部存储后重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取外接儲存裝置路徑：%@。請連接外接儲存裝置後重新檢查。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读不到外部存储路径：%@。请連接外部存储后重新检查。"
          }
        }
      }
    },
    "读不到当前选择的外部存储「%@」，它可能没有连接或已被推出。连接后点「重新检查」；没有做任何改动。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت قراءة التخزين الخارجي المحدد «%@». ربما يكون مفصولًا أو تم إخراجه. وصّله وانقر على «إعادة الفحص»؛ لم يُجرَ أي تغيير."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠎⠑⠇⠑⠉⠞⠑⠙ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠎⠞⠕⠗⠁⠛⠑ “%@” ⠉⠁⠝⠄⠞ ⠃⠑ ⠗⠑⠁⠙⠲ ⠠⠊⠞ ⠍⠁⠽ ⠃⠑ ⠙⠊⠎⠉⠕⠝⠝⠑⠉⠞⠑⠙ ⠕⠗ ⠑⠚⠑⠉⠞⠑⠙⠲ ⠠⠉⠕⠝⠝⠑⠉⠞ ⠊⠞ ⠁⠝⠙ ⠉⠇⠊⠉⠅ ⠠⠉⠓⠑⠉⠅ ⠠⠁⠛⠁⠊⠝⠲ ⠠⠝⠕⠞⠓⠊⠝⠛ ⠺⠁⠎ ⠉⠓⠁⠝⠛⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ausgewählte externe Speicher „%@“ kann nicht gelesen werden. Er ist möglicherweise nicht verbunden oder wurde ausgeworfen. Verbinde ihn und klicke auf „Erneut prüfen“. Es wurde nichts verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected external storage “%@” can't be read. It may be disconnected or ejected. Connect it and click Check Again. Nothing was changed."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La elektita ekstera konservilo “%@” ne estas legebla. Ĝi eble estas malkonektita aŭ elĵetita. Konektu ĝin kaj alklaku “Rekontroli”; nenio estis ŝanĝita."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer el almacenamiento externo «%@» seleccionado. Puede estar desconectado o haberse expulsado. Conéctalo y haz clic en «Volver a comprobar». No se ha modificado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le stockage externe « %@ » actuellement sélectionné. Il est peut-être déconnecté ou a été éjecté. Connectez-le, puis cliquez sur « Vérifier à nouveau ». Rien n’a été modifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुना गया बाहरी स्टोरेज “%@” पढ़ा नहीं जा सका। वह शायद जुड़ा नहीं है या इजेक्ट किया गया है। उसे जोड़कर “फिर से जाँचें” पर क्लिक करें। कोई बदलाव नहीं किया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan eksternal “%@” yang dipilih tidak dapat dibaca. Mungkin belum terhubung atau telah dikeluarkan. Hubungkan lalu klik “Periksa lagi”; tidak ada yang diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere l’unità esterna selezionata “%@”. Potrebbe essere scollegata o espulsa. Collegala e fai clic su “Verifica di nuovo”. Non è stata apportata alcuna modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在選択している外部ストレージ「%@」を読み取れません。接続されていないか、取り出された可能性があります。接続してから「再チェック」をクリックしてください。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 선택한 외장 저장 장치 “%@”을(를) 읽을 수 없습니다. 연결되지 않았거나 추출되었을 수 있습니다. 연결한 후 “다시 확인”을 클릭하세요. 아무것도 변경하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde externe opslag ‘%@’ kan niet worden gelezen. Deze is mogelijk losgekoppeld of verwijderd. Sluit de opslag aan en klik op ‘Controleer opnieuw’. Er is niets gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać wybranego nośnika zewnętrznego „%@”. Może być odłączony lub wysunięty. Podłącz go i kliknij „Sprawdź ponownie”. Niczego nie zmieniono."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler o armazenamento externo selecionado “%@”. Ele pode estar desconectado ou ter sido ejetado. Conecte-o e clique em “Verificar novamente”. Nada foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся прочитать выбранный внешний накопитель «%@». Возможно, он отключён или извлечён. Подключите его и нажмите «Проверить снова». Ничего не изменено."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านอุปกรณ์จัดเก็บข้อมูลภายนอก “%@” ที่เลือกอยู่ไม่ได้ อาจยังไม่ได้เชื่อมต่อหรือถูกนำออกแล้ว เชื่อมต่อแล้วคลิก “ตรวจสอบอีกครั้ง” ยังไม่มีการเปลี่ยนแปลงใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili harici depolama “%@” okunamıyor. Bağlı olmayabilir veya çıkarılmış olabilir. Bağladıktan sonra “Yeniden Kontrol Et”e tıklayın. Hiçbir değişiklik yapılmadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc bộ nhớ ngoài “%@” đang được chọn. Có thể bộ nhớ chưa kết nối hoặc đã được tháo. Hãy kết nối rồi bấm “Kiểm tra lại”; chưa thay đổi gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读不到当前选择的外部存储「%@」，它可能没有连接或已被推出。连接后点「重新检查」；没有做任何改动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取目前選擇的外接儲存裝置「%@」，它可能未連接或已退出。連接後請按一下「重新檢查」；未做任何更動。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读不到当前选择的外部存储「%@」，它可能没有連接或已被推絀。連接后点「重新检查」；没有做任何改动。"
          }
        }
      }
    },
