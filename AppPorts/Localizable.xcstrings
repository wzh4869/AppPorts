    "加密卷操作失败，请检查密码和磁盘访问权限后重试。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت عملية وحدة التخزين المشفرة. تحقّق من كلمة المرور وإذن الوصول إلى القرص ثم أعد المحاولة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠑⠝⠉⠗⠽⠏⠞⠑⠙ ⠧⠕⠇⠥⠍⠑ ⠕⠏⠑⠗⠁⠞⠊⠕⠝ ⠋⠁⠊⠇⠑⠙⠲ ⠠⠉⠓⠑⠉⠅ ⠞⠓⠑ ⠏⠁⠎⠎⠺⠕⠗⠙ ⠁⠝⠙ ⠙⠊⠎⠅ ⠁⠉⠉⠑⠎⠎⠂ ⠞⠓⠑⠝ ⠞⠗⠽ ⠁⠛⠁⠊⠝⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Vorgang auf dem verschlüsselten Volume ist fehlgeschlagen. Prüfe Passwort und Datenträgerzugriff und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The encrypted volume operation failed. Check the password and disk access, then try again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operacio sur la ĉifrita volumo malsukcesis. Kontrolu la pasvorton kaj diskaliron, poste reprovu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operación en el volumen cifrado ha fallado. Comprueba la contraseña y el acceso al disco y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération sur le volume chiffré a échoué. Vérifiez le mot de passe et l’accès au disque, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एन्क्रिप्टेड वॉल्यूम पर कार्रवाई विफल रही। पासवर्ड और डिस्क एक्सेस जाँचकर फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operasi pada volume terenkripsi gagal. Periksa kata sandi dan akses disk, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’operazione sul volume crittografato non è riuscita. Controlla la password e l’accesso al disco, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化ボリュームの操作に失敗しました。パスワードとディスクへのアクセス権を確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 볼륨 작업에 실패했습니다. 암호와 디스크 접근 권한을 확인한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bewerking op het versleutelde volume is mislukt. Controleer het wachtwoord en de schijftoegang en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operacja na zaszyfrowanym woluminie nie powiodła się. Sprawdź hasło i dostęp do dysku, a następnie spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A operação no volume criptografado falhou. Verifique a senha e o acesso ao disco e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выполнить операцию с зашифрованным томом. Проверьте пароль и доступ к диску и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการกับโวลุ่มที่เข้ารหัสล้มเหลว กรุณาตรวจสอบรหัสผ่านและการเข้าถึงดิสก์แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifreli birim işlemi başarısız oldu. Parolayı ve disk erişimini kontrol edip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác trên ổ được mã hóa không thành công. Hãy kiểm tra mật khẩu và quyền truy cập đĩa rồi thử lại."
