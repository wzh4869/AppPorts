    "旧位置的应用仍在运行，应用位置已切换，退出后可继续清理。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما زال التطبيق في الموقع القديم قيد التشغيل. تم تبديل الموقع؛ أغلق ذلك المثيل لمتابعة التنظيف."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠁⠏⠏ ⠁⠞ ⠞⠓⠑ ⠕⠇⠙ ⠇⠕⠉⠁⠞⠊⠕⠝ ⠊⠎ ⠎⠞⠊⠇⠇ ⠗⠥⠝⠝⠊⠝⠛⠲ ⠠⠞⠓⠑ ⠇⠕⠉⠁⠞⠊⠕⠝ ⠓⠁⠎ ⠎⠺⠊⠞⠉⠓⠑⠙⠆ ⠟⠥⠊⠞ ⠞⠓⠁⠞ ⠊⠝⠎⠞⠁⠝⠉⠑ ⠞⠕ ⠉⠕⠝⠞⠊⠝⠥⠑ ⠉⠇⠑⠁⠝⠥⠏⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App am alten Speicherort läuft noch. Der Speicherort wurde umgestellt; beenden Sie diese Instanz, um die Bereinigung fortzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app at the old location is still running. The location has switched; quit that instance to continue cleanup."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplikaĵo ĉe la malnova loko ankoraŭ ruliĝas. La loko estas ŝanĝita; fermu tiun instancon por daŭrigi purigon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app de la ubicación anterior sigue ejecutándose. La ubicación ha cambiado; cierre esa instancia para continuar la limpieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app de l’ancien emplacement est toujours en cours d’exécution. L’emplacement a changé ; quittez cette instance pour continuer le nettoyage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुराने स्थान का ऐप अभी भी चल रहा है। स्थान बदल गया है; सफ़ाई जारी रखने के लिए उस इंस्टेंस को बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi di lokasi lama masih berjalan. Lokasi telah beralih; tutup instans tersebut untuk melanjutkan pembersihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app nella vecchia posizione è ancora in esecuzione. La posizione è cambiata; chiudi quell’istanza per continuare la pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い場所のアプリがまだ実行中です。場所は切り替わっています。そのアプリを終了すると削除を続行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 위치의 앱이 아직 실행 중입니다. 위치는 전환되었습니다. 해당 앱을 종료하면 정리를 계속할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app op de oude locatie draait nog. De locatie is omgeschakeld; sluit die instantie om het opruimen voort te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja w starej lokalizacji nadal działa. Lokalizacja została przełączona; zamknij tamto wystąpienie, aby kontynuować usuwanie kopii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app no local antigo ainda está em execução. O local foi alterado; encerre essa instância para continuar a limpeza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение в старом расположении ещё работает. Расположение переключено; завершите этот экземпляр, чтобы продолжить очистку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปที่ตำแหน่งเก่ายังทำงานอยู่ สลับตำแหน่งแล้ว โปรดปิดแอปอินสแตนซ์นั้นเพื่อดำเนินการลบต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski konumdaki uygulama hâlâ çalışıyor. Konum değiştirildi; temizliği sürdürmek için o örneği kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng ở vị trí cũ vẫn đang chạy. Vị trí đã được chuyển; hãy thoát phiên bản đó để tiếp tục dọn dẹp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧位置的应用仍在运行，应用位置已切换，退出后可继续清理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舊位置的應用程式仍在執行；位置已切換，結束該實例後可繼續清理。"
          }
        },
        "zh-martian" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舊位置的應甪仍在運荇，應甪位置已切換，退出后可繼續淸理。"
          }
        }
      }
