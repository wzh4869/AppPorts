    "用户取消了管理员授权，无法执行磁盘命令（%@）" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغى المستخدم منح صلاحيات المسؤول، لذا تعذر تنفيذ أمر القرص (%@)"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠙⠍⠊⠝⠊⠎⠞⠗⠁⠞⠕⠗ ⠁⠥⠞⠓⠕⠗⠊⠵⠁⠞⠊⠕⠝ ⠺⠁⠎ ⠉⠁⠝⠉⠑⠇⠇⠑⠙⠆ ⠙⠊⠎⠅ ⠉⠕⠍⠍⠁⠝⠙ ⠝⠕⠞ ⠗⠥⠝ ⠐⠣%@⠐⠜"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Administratorautorisierung wurde abgebrochen. Der Festplattenbefehl kann nicht ausgeführt werden (%@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator authorization was cancelled; disk command not run (%@)"
