        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçici öğenin aidiyeti doğrulanamadı. Öğe korundu; bu deneme sona erdi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác nhận mục tạm thuộc thao tác này. Mục đã được giữ lại; lần thử này đã kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂存对象归属无法确认，已保留；此尝试已结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫存物件的歸屬無法確認，已保留；此嘗試已結束。"
