        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toegang voor deze AppPorts kon niet worden bevestigd: testbestanden zijn niet beschikbaar of er is een andere leesfout opgetreden. Controleer Systeeminstellingen."
