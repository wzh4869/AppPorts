    "磁盘尚未弹出，自动挂载已暂停。" : {
      "comment" : "Approved 2026-10-23: Chinese and English only; other locales explicitly fall back to English.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إخراج القرص بعد. تم إيقاف التحميل التلقائي مؤقتاً."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠙⠊⠎⠅ ⠓⠁⠎ ⠝⠕⠞ ⠃⠑⠑⠝ ⠑⠚⠑⠉⠞⠑⠙⠲ ⠠⠁⠥⠞⠕⠍⠁⠞⠊⠉ ⠍⠕⠥⠝⠞⠊⠝⠛ ⠊⠎ ⠏⠁⠥⠎⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenträger wurde noch nicht ausgeworfen. Das automatische Einhängen ist pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk has not been ejected. Automatic mounting is paused."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disko ankoraŭ ne estas elĵetita. Aŭtomata muntado estas paŭzigita."
