          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر طلب إخراج القرص من Finder. تحقق من أذونات الأتمتة ثم أعد المحاولة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠋⠊⠝⠙⠑⠗ ⠉⠕⠥⠇⠙ ⠝⠕⠞ ⠃⠑ ⠁⠎⠅⠑⠙ ⠞⠕ ⠑⠚⠑⠉⠞ ⠞⠓⠑ ⠙⠊⠎⠅⠲ ⠠⠉⠓⠑⠉⠅ ⠠⠁⠥⠞⠕⠍⠁⠞⠊⠕⠝ ⠏⠑⠗⠍⠊⠎⠎⠊⠕⠝⠎ ⠁⠝⠙ ⠗⠑⠞⠗⠽⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder lässt sich nicht zum Auswerfen des Datenträgers auffordern. Prüfen Sie die Automatisierungsberechtigungen und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder could not be asked to eject the disk. Check Automation permissions and retry."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne eblas peti Finder elĵeti la diskon. Kontrolu la permesojn por aŭtomatigo kaj reprovu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede solicitar a Finder que expulse el disco. Comprueba los permisos de Automatización y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de demander à Finder d’éjecter le disque. Vérifiez les autorisations d’automatisation, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder से डिस्क इजेक्ट करने का अनुरोध नहीं किया जा सका। ऑटोमेशन अनुमतियाँ जाँचें, फिर दोबारा प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat meminta Finder untuk mengeluarkan disk. Periksa izin Otomatisasi lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile chiedere a Finder di espellere il disco. Controlla i permessi di Automazione, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder にディスクの取り出しを要求できません。「オートメーション」の権限を確認してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder에 디스크 추출을 요청할 수 없습니다. 자동화 권한을 확인한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder kan niet worden gevraagd de schijf uit te werpen. Controleer de automatiseringsrechten en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można poprosić Findera o wysunięcie dysku. Sprawdź uprawnienia automatyzacji i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível pedir ao Finder para ejetar o disco. Verifique as permissões de Automatização e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запросить извлечение диска через Finder. Проверьте разрешения автоматизации и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถขอให้ Finder นำดิสก์ออกได้ โปรดตรวจสอบสิทธิ์การทำงานอัตโนมัติแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder’dan diski çıkarması istenemedi. Otomasyon izinlerini kontrol edip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể yêu cầu Finder đẩy đĩa ra. Hãy kiểm tra quyền Tự động hóa rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
