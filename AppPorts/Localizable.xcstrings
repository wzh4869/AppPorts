    "其他磁盘操作结束后会自动继续。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستستمر العملية تلقائيًا عند انتهاء عمليات القرص الأخرى."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠕⠏⠑⠗⠁⠞⠊⠕⠝ ⠺⠊⠇⠇ ⠉⠕⠝⠞⠊⠝⠥⠑ ⠁⠥⠞⠕⠍⠁⠞⠊⠉⠁⠇⠇⠽ ⠺⠓⠑⠝ ⠕⠞⠓⠑⠗ ⠙⠊⠎⠅ ⠕⠏⠑⠗⠁⠞⠊⠕⠝⠎ ⠋⠊⠝⠊⠎⠓⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Vorgang wird automatisch fortgesetzt, sobald die anderen Datenträgervorgänge abgeschlossen sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The operation will continue automatically when other disk operations finish."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operacio aŭtomate daŭros kiam aliaj diskaj operacioj finiĝos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operación continuará automáticamente cuando terminen las demás operaciones de disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération reprendra automatiquement à la fin des autres opérations sur le disque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क के अन्य कार्य समाप्त होने पर यह कार्य अपने आप जारी रहेगा।"
          }
        },
        "id" : {
