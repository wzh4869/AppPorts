      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الحذف، لن يمكن استخدام هذا الأصل لاستعادة التوقيع. سيُحفظ التطبيق الحالي وبياناته."
          }
        },
        "br" : {
          "stringUnit" : {
