    "Not configured. In App Store Settings, enable external installation for apps larger than 1 GB and choose the same external drive as AppPorts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مُعدّ. في إعدادات App Store، فعّل التثبيت الخارجي للتطبيقات الأكبر من 1 غيغابايت واختر نفس القرص الخارجي المستخدم في AppPorts."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠝⠕⠞ ⠉⠕⠝⠋⠊⠛⠥⠗⠑⠙⠲ ⠠⠊⠝ ⠠⠁⠏⠏ ⠠⠎⠞⠕⠗⠑ ⠠⠎⠑⠞⠞⠊⠝⠛⠎⠂ ⠑⠝⠁⠃⠇⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠊⠝⠎⠞⠁⠇⠇⠁⠞⠊⠕⠝ ⠋⠕⠗ ⠁⠏⠏⠎ ⠇⠁⠗⠛⠑⠗ ⠞⠓⠁⠝ ⠼⠁ ⠠⠛⠠⠃ ⠁⠝⠙ ⠉⠓⠕⠕⠎⠑ ⠞⠓⠑ ⠎⠁⠍⠑ ⠑⠭⠞⠑⠗⠝⠁⠇ ⠙⠗⠊⠧⠑ ⠁⠎ ⠠⠁⠏⠏⠠⠏⠕⠗⠞⠎⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
