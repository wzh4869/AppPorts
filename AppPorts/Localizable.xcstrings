    "复制期间目录位置发生变化，已保留副本。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر موقع المجلد أثناء النسخ، لذا تم الاحتفاظ بالنسخة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠋⠕⠇⠙⠑⠗ ⠇⠕⠉⠁⠞⠊⠕⠝ ⠉⠓⠁⠝⠛⠑⠙ ⠙⠥⠗⠊⠝⠛ ⠉⠕⠏⠽⠊⠝⠛⠂ ⠎⠕ ⠞⠓⠑ ⠉⠕⠏⠽ ⠓⠁⠎ ⠃⠑⠑⠝ ⠅⠑⠏⠞⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordnerort hat sich während des Kopierens geändert, daher wurde die Kopie behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder location changed during copying, so the copy has been kept."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dosieruja loko ŝanĝiĝis dum la kopiado, do la kopio konserviĝis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación de la carpeta ha cambiado durante la copia, así que se ha conservado la copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’emplacement du dossier a changé pendant la copie ; la copie a donc été conservée."
