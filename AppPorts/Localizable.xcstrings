    "应用位置或更新现场已变化，已停止回退并保留必要副本。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير موقع التطبيق أو حالة التحديث. تم إيقاف الاستعادة وتم الاحتفاظ بالنسخ الضرورية."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠁⠏⠏ ⠇⠕⠉⠁⠞⠊⠕⠝ ⠕⠗ ⠥⠏⠙⠁⠞⠑ ⠎⠞⠁⠞⠑ ⠉⠓⠁⠝⠛⠑⠙⠲ ⠠⠗⠕⠇⠇⠃⠁⠉⠅ ⠎⠞⠕⠏⠏⠑⠙ ⠁⠝⠙ ⠝⠑⠉⠑⠎⠎⠁⠗⠽ ⠉⠕⠏⠊⠑⠎ ⠺⠑⠗⠑ ⠅⠑⠏⠞⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App-Standort oder Update-Status hat sich geändert. Das Rollback wurde gestoppt und die erforderlichen Kopien wurden aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app location or update state changed. Rollback stopped and necessary copies were kept."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplika loko aŭ ĝisdatiga stato ŝanĝiĝis. Rollback ĉesis kaj necesaj kopioj estis konservitaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación de la aplicación o el estado de actualización cambiaron. La reversión se detuvo y se conservaron las copias necesarias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'emplacement de l'application ou l'état de la mise à jour a changé. La restauration a été arrêtée et les copies nécessaires ont été conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का स्थान या अपडेट स्थिति बदल गई. रोलबैक रुक गया और आवश्यक प्रतियां रख ली गईं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi aplikasi atau status pembaruan berubah. Rollback dihentikan dan salinan yang diperlukan disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione dell'app o lo stato dell'aggiornamento sono cambiati. Il rollback è stato interrotto e le copie necessarie sono state conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの場所または更新状態が変更されました。ロールバックが停止し、必要なコピーが保持されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 위치 또는 업데이트 상태가 변경되었습니다. 롤백이 중지되고 필요한 복사본이 보관되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app-locatie of updatestatus is gewijzigd. Het terugdraaien werd gestopt en de benodigde kopieën werden bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniła się lokalizacja aplikacji lub stan aktualizacji. Wycofanie zmian zostało zatrzymane, a niezbędne kopie zostały zachowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização do aplicativo ou o estado de atualização foram alterados. A reversão foi interrompida e as cópias necessárias foram mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Местоположение приложения или состояние обновления изменилось. Откат остановлен, необходимые копии сохранены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตำแหน่งแอปหรือสถานะการอัปเดตเปลี่ยนไป หยุดการย้อนกลับและเก็บสำเนาที่จำเป็นไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama konumu veya güncelleme durumu değişti. Geri alma durduruldu ve gerekli kopyalar saklandı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
