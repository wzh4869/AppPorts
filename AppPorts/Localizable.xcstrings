    "取消请求已处理；已完成的迁移步骤不会撤销。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت معالجة طلب الإلغاء؛ لن تُلغى خطوات الترحيل المكتملة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠑ ⠉⠁⠝⠉⠑⠇ ⠗⠑⠟⠥⠑⠎⠞ ⠺⠁⠎ ⠓⠁⠝⠙⠇⠑⠙⠆ ⠉⠕⠍⠏⠇⠑⠞⠑⠙ ⠍⠊⠛⠗⠁⠞⠊⠕⠝ ⠎⠞⠑⠏⠎ ⠁⠗⠑⠝’⠞ ⠥⠝⠙⠕⠝⠑⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abbruchanforderung wurde verarbeitet; bereits abgeschlossene Migrationsschritte werden nicht rückgängig gemacht."
          }
