          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いコピーは管理者（root）が所有しています。削除には認証が必要です。現在のデータには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
