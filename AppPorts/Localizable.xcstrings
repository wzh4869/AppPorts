          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli prima un archivio esterno in AppPorts prima di configurare l’installazione esterna dell’App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store の外部インストールを設定する前に、AppPorts で外部ストレージを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 외장 설치를 구성하기 전에 먼저 AppPorts에서 외부 저장 공간을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
