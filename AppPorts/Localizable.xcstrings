    "保留现状：「%@」的数据继续留在本机，一切照旧，以后随时可以再迁移" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإبقاء كما هو: تبقى بيانات «%@» على هذا الـ Mac دون أي تغيير، ويمكنك ترحيلها في أي وقت لاحقًا"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠅⠑⠑⠏ ⠞⠓⠊⠝⠛⠎ ⠁⠎ ⠞⠓⠑⠽ ⠁⠗⠑⠒ “%@” ⠙⠁⠞⠁ ⠎⠞⠁⠽⠎ ⠕⠝ ⠞⠓⠊⠎ ⠠⠍⠁⠉⠂ ⠝⠕⠞⠓⠊⠝⠛ ⠉⠓⠁⠝⠛⠑⠎⠂ ⠁⠝⠙ ⠽⠕⠥ ⠉⠁⠝ ⠍⠊⠛⠗⠁⠞⠑ ⠊⠞ ⠁⠝⠽ ⠞⠊⠍⠑ ⠇⠁⠞⠑⠗"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So belassen: Die Daten von „%@“ bleiben auf diesem Mac. Alles bleibt wie bisher, und du kannst die Daten jederzeit später migrieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep things as they are: “%@” data stays on this Mac, nothing changes, and you can migrate it any time later"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasi senŝanĝe: la datumoj de “%@” restas sur ĉi tiu Mac, ĉio restas sama, kaj vi povas migrigi ilin iam ajn poste"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejar como está: los datos de «%@» permanecen en este Mac, todo sigue igual y puedes migrarlos en cualquier momento"
          }
        },
        "fr" : {
