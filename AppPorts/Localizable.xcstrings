    "现有日志文件将移至废纸篓，可在需要时从废纸篓恢复。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقل ملفات السجل الحالية إلى سلة المهملات بحيث يمكنك استعادتها عند الحاجة."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠑⠭⠊⠎⠞⠊⠝⠛ ⠇⠕⠛ ⠋⠊⠇⠑⠎ ⠺⠊⠇⠇ ⠃⠑ ⠍⠕⠧⠑⠙ ⠞⠕ ⠞⠓⠑ ⠠⠞⠗⠁⠎⠓⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhandene Protokolldateien werden in den Papierkorb bewegt und können bei Bedarf wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing log files will be moved to the Trash so you can recover them if needed."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekzistantaj protokoldosieroj estos movitaj al la Rubujo por ke vi povu restarigi ilin se necese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de registro existentes se moverán a la Papelera para que puedas recuperarlos si los necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers journaux existants seront déplacés vers la Corbeille afin que vous puissiez les récupérer si nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा लॉग फ़ाइलें ट्रैश में भेज दी जाएँगी ताकि ज़रूरत पड़ने पर आप उन्हें वापस पा सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File log yang ada akan dipindahkan ke Sampah agar Anda dapat memulihkannya jika diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file di log esistenti verranno spostati nel Cestino così potrai recuperarli se necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のログファイルはゴミ箱に移動されるため、必要に応じて復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 로그 파일이 휴지통으로 이동되므로 필요할 때 복원할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestaande logbestanden worden naar de Prullenmand verplaatst zodat je ze indien nodig kunt herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istniejące pliki dziennika zostaną przeniesione do Kosza, aby można je było w razie potrzeby odzyskać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos de log existentes serão movidos para o Lixo para que você possa recuperá-los se precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Существующие файлы журналов будут перемещены в Корзину, чтобы при необходимости их можно было восстановить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์บันทึกที่มีอยู่จะถูกย้ายไปยังถังขยะ เพื่อให้คุณกู้คืนได้หากต้องการ"
