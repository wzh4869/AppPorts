      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل قديم لنقل التطبيق تالف. لا يستطيع AppPorts تأكيد البيانات في هذا الموقع. البيانات محفوظة ولم تبدأ العملية."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠁⠝ ⠕⠇⠙⠑⠗ ⠁⠏⠏ ⠞⠗⠁⠝⠎⠋⠑⠗ ⠗⠑⠉⠕⠗⠙ ⠊⠎ ⠙⠁⠍⠁⠛⠑⠙⠲ ⠠⠁⠏⠏⠠⠏⠕⠗⠞⠎ ⠉⠁⠝⠝⠕⠞ ⠉⠕⠝⠋⠊⠗⠍ ⠞⠓⠑ ⠙⠁⠞⠁ ⠁⠞ ⠞⠓⠊⠎ ⠇⠕⠉⠁⠞⠊⠕⠝⠲ ⠠⠙⠁⠞⠁ ⠊⠎ ⠏⠗⠑⠎⠑⠗⠧⠑⠙ ⠁⠝⠙ ⠞⠓⠊⠎ ⠕⠏⠑⠗⠁⠞⠊⠕⠝ ⠓⠁⠎ ⠝⠕⠞ ⠎⠞⠁⠗⠞⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein älterer App-Transfereintrag ist beschädigt. AppPorts kann die Daten an diesem Ort nicht bestätigen. Daten bleiben erhalten; dieser Vorgang wurde nicht gestartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An older app transfer record is damaged. AppPorts cannot confirm the data at this location. Data is preserved and this operation has not started."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malnova registro pri aplikaĵa transigo estas difektita. AppPorts ne povas konfirmi la datumojn ĉe ĉi tiu loko. Datumoj estas konservitaj kaj la operacio ne komenciĝis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro anterior de traslado de la aplicación está dañado. AppPorts no puede confirmar los datos de esta ubicación. Los datos se conservan y esta operación no ha comenzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ancien enregistrement de transfert de l’application est endommagé. AppPorts ne peut pas confirmer les données à cet emplacement. Les données sont conservées et l’opération n’a pas commencé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप स्थानांतरण का पुराना रिकॉर्ड खराब है। AppPorts इस स्थान के डेटा की पुष्टि नहीं कर सकता। डेटा सुरक्षित है और कार्रवाई शुरू नहीं हुई।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
