        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorbereitung ist unvollständig. Du kannst sie abbrechen und diese temporäre Kopie entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparation is incomplete. You can cancel and remove this temporary copy."
