        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datumoj ŝanĝiĝis dum la operacio aŭ la kontrolo trovis malsamon. Kopioj estas konservitaj. Kontrolu ilin antaŭ reprovo: %@"
