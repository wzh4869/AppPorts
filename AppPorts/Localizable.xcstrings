          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movu grandajn aplikaĵojn al ekstera disko aŭ APFS-aplikaĵbiblioteka bildo, konservante malpezan Stub Portal loke por malfermi ilin kutime el Finder kaj Dock."
          }
        },
        "es" : {
          "stringUnit" : {
