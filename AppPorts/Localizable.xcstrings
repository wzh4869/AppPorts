    },
    "此系统版本要求管理员权限才能执行磁盘命令，当前环境无法弹出授权框（%@）" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب إصدار النظام هذا صلاحيات مسؤول لتنفيذ أمر القرص، ولا يمكن عرض نافذة منح الإذن في البيئة الحالية (%@)"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠞⠓⠊⠎ ⠍⠁⠉⠠⠕⠠⠎ ⠧⠑⠗⠎⠊⠕⠝ ⠗⠑⠟⠥⠊⠗⠑⠎ ⠁⠙⠍⠊⠝⠊⠎⠞⠗⠁⠞⠕⠗ ⠏⠗⠊⠧⠊⠇⠑⠛⠑⠎ ⠋⠕⠗ ⠞⠓⠊⠎ ⠙⠊⠎⠅ ⠉⠕⠍⠍⠁⠝⠙⠂ ⠁⠝⠙ ⠝⠕ ⠁⠥⠞⠓⠕⠗⠊⠵⠁⠞⠊⠕⠝ ⠏⠗⠕⠍⠏⠞ ⠊⠎ ⠁⠧⠁⠊⠇⠁⠃⠇⠑ ⠓⠑⠗⠑ ⠐⠣%@⠐⠜"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Systemversion benötigt Administratorrechte für Festplattenbefehle. In der aktuellen Umgebung kann kein Autorisierungsdialog angezeigt werden (%@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This macOS version requires administrator privileges for this disk command, and no authorization prompt is available here (%@)"
          }
        },
        "eo" : {
