    "空间不足：需要约 %@ 可用空间，目前只有 %@。未做任何改动。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساحة غير كافية: يلزم نحو %@ من المساحة المتاحة، والمتاح حاليًا %@ فقط. لم يُجرَ أي تغيير."
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⠠⠝⠕⠞ ⠑⠝⠕⠥⠛⠓ ⠎⠏⠁⠉⠑⠒ ⠁⠃⠕⠥⠞ %@ ⠕⠋ ⠋⠗⠑⠑ ⠎⠏⠁⠉⠑ ⠊⠎ ⠝⠑⠑⠙⠑⠙⠂ ⠃⠥⠞ ⠕⠝⠇⠽ %@ ⠊⠎ ⠁⠧⠁⠊⠇⠁⠃⠇⠑⠲ ⠠⠝⠕⠞⠓⠊⠝⠛ ⠺⠁⠎ ⠉⠓⠁⠝⠛⠑⠙⠲"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug Speicherplatz: Benötigt werden etwa %@ freier Speicherplatz, verfügbar sind nur %@. Es wurde nichts verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough space: about %@ of free space is needed, but only %@ is available. Nothing was changed."
