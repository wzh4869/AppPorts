          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản sao cũ được liệt kê sẽ bị xóa sau khi xác minh. Dữ liệu hiện tại sẽ được giữ nguyên."
          }
