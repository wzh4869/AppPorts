        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app has been migrated to external storage and remains unlocked, so you can try to continue using in-app updates. Enable “App Update Guardian” in Settings to let AppPorts help with update issues, though successful recovery is not guaranteed for every app."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉi tiu apo estis migrita al ekstera konservejo kaj restas neŝlosita, do vi povas provi daŭre uzi en-apajn ĝisdatigojn. Ŝaltu «Gardanto de ap-ĝisdatigoj» en Agordoj por lasi AppPorts helpi pri ĝisdatigaj problemoj, kvankam sukceso ne estas garantiita por ĉiu apo."
          }
        },
        "es" : {
          "stringUnit" : {
