          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock में कोई आइटम अपडेट करने की ज़रूरत नहीं है। अगर यह ऐप अभी तक पिन नहीं है, तो इसे खोलें और “Dock में रखें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
