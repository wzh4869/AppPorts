        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor der Bereinigung der alten Kopie werden die verwendeten Daten geprüft, um sicherzustellen, dass die Dateien am neuen Speicherort noch vollständig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
