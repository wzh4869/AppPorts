        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La komenca kontrolo de la anstataŭigota celo ne estis konservita. Ambaŭ kopioj restas; nuligu ĉi tiun provon kaj elektu la celon denove."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guardó la verificación inicial del destino que se va a reemplazar. Se conservaron ambas copias; cancele este intento y seleccione de nuevo el destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification initiale de la cible à remplacer n’a pas été enregistrée. Les deux copies ont été conservées ; annulez cette tentative et sélectionnez à nouveau la cible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदले जाने वाले लक्ष्य का शुरुआती सत्यापन रिकॉर्ड सहेजा नहीं गया। दोनों प्रतियाँ सुरक्षित हैं; यह प्रयास रद्द करके लक्ष्य दोबारा चुनें।"
