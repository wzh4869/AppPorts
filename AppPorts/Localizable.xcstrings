        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교체 대상의 최초 검증 기록이 저장되지 않았습니다. 양쪽 복사본을 보존했습니다. 이 시도를 취소하고 대상을 다시 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eerste controle van het te vervangen doel is niet opgeslagen. Beide kopieën zijn bewaard; annuleer deze poging en kies het doel opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
