          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite a senha do volume de dados definida na migração. Ela pode ser reutilizada por 30 minutos, e as operações em curso seguem até ao fim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите пароль тома данных, заданный при переносе. Он действует 30 минут, а начатые операции выполняются до конца."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนรหัสผ่านโวลุ่มข้อมูลที่ตั้งไว้ตอนย้ายข้อมูล ใช้ซ้ำได้ภายใน 30 นาที และการดำเนินการที่กำลังทำอยู่จะดำเนินต่อจนเสร็จ"
          }
        },
        "tr" : {
